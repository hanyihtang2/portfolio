---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  docTitle?: string;
  image?: string;
  mainClass?: string;
}

const {
  title,
  description = "CV and professional portfolio of Han-Yih Tang, Technical Product Manager & Builder",
  docTitle,
  image,
  mainClass,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://hanyihtang2.github.io";

const pageTitle = docTitle || `${title} - Han-Yih Tang`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || "https://hanyihtang2.github.io").href;

const ogImageUrl = image
  ? (image.startsWith('http') ? image : `${siteUrl}${base}${image.startsWith('/') ? image : `/${image}`}`)
  : `${siteUrl}${base}/images/og-preview.png`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{pageTitle}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / LinkedIn / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Han-Yih Tang - Technical Product Manager & Builder Portfolio" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = savedTheme ? savedTheme === 'dark' : prefersDark;
          document.documentElement.classList.toggle('dark', isDark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 min-h-screen flex flex-col font-sans antialiased">
    <!-- Accessible Skip to Content Link (WCAG 2.4.1) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-md focus:shadow-lg focus:outline-none text-sm font-semibold"
    >
      Skip to main content
    </a>
    <Navbar />
    <main id="main-content" class={`flex-1 ${mainClass ?? 'max-w-5xl w-full mx-auto px-6 pt-8 sm:pt-10 pb-16'}`}>
      <slot />
    </main>
    <footer class="border-t border-default py-8 text-center text-xs text-zinc-600 dark:text-zinc-400">
      © {new Date().getFullYear()} Built with Astro & Tailwind.
    </footer>
  </body>
</html>
