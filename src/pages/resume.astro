---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Resume - Han-Yih Tang"
  docTitle="Han-Yih Tang - Resume"
  description="CV and professional experience of Han-Yih Tang, Technical Product Manager & Builder"
>
  <div>
    <!-- Top Action Bar (Hidden when printing) -->
    <div class="print-hidden flex flex-wrap items-center justify-end gap-3 mb-8 pb-4 border-b border-default">
      <a
        href={`${base}/contact`}
        class="btn-secondary"
      >
        Contact Me
      </a>
      <button
        id="print-resume-btn"
        type="button"
        class="btn-primary"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        <span>Print / Save as PDF</span>
      </button>
    </div>

    <!-- Resume Sheet -->
    <div class="resume-sheet card-base p-6 sm:p-10 space-y-section">
      <!-- Header -->
      <header class="pb-2 flex flex-col md:flex-row md:items-start justify-between gap-6">
        <div>
          <h1 class="type-h1">
            Han-Yih Tang
          </h1>
          <p class="type-subhead mt-1">
             Product Manager | Product Owner
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-[max-content_max-content] gap-x-8 gap-y-1.5 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
          <!-- Column 1: Location, Portfolio, LinkedIn -->
          <div class="flex flex-col gap-1.5">
            <span class="inline-flex items-center gap-2 whitespace-nowrap">
              <svg class="w-4 h-4 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>London, UK</span>
            </span>

            <a
              href="https://hanyihtang2.github.io/portfolio"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 whitespace-nowrap text-blue-600 dark:text-blue-400 hover:underline font-medium"
            >
              <svg class="w-4 h-4 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
              </svg>
              <span>hanyihtang2.github.io/portfolio<span class="print-hidden"> ↗</span></span>
            </a>

            <a
              href="https://www.linkedin.com/in/hanyih-tang"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 whitespace-nowrap text-blue-600 dark:text-blue-400 hover:underline font-medium"
            >
