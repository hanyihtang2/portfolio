<script is:inline>
  (function () {
    const resumeTitle = 'Han-Yih Tang - Resume';

    const printBtn = document.getElementById('print-resume-btn');
    if (printBtn) {
      printBtn.addEventListener('click', () => {
        document.title = resumeTitle;
        window.print();
      });
    }
  })();
</script>

