---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const featuredProjects = await getCollection('projects', ({ data }) => data.featured);
---

<BaseLayout title="Home" description="Full-stack developer portfolio">
  <section class="py-12 space-y-6">
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">
      Software Engineer & Builder<span class="text-blue-500">.</span>
    </h1>
    <p class="text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl">
      I build scalable web apps, developer tools, and distributed services. Currently crafting showcase systems and documenting the process.
    </p>
    <div class="flex gap-4 pt-2">
      <a href={`${base}/projects`} class="px-5 py-2.5 bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 rounded-md font-medium text-sm hover:opacity-90">
        View Projects
      </a>
      <a href={`${base}/contact`} class="px-5 py-2.5 border border-zinc-300 dark:border-zinc-700 rounded-md font-medium text-sm hover:bg-zinc-100 dark:hover:bg-zinc-900">
        Get in Touch
      </a>
    </div>
  </section>

  <section class="mt-16">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold tracking-tight">Featured Projects</h2>
      <a href={`${base}/projects`} class="text-sm text-blue-500 hover:underline">All projects →</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map(project => (
        <a href={`${base}/projects/${project.id}`} class="block p-6 border border-zinc-200 dark:border-zinc-800 rounded-lg hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors bg-white dark:bg-zinc-900">
          <div class="flex justify-between items-start mb-2">
            <h3 class="text-lg font-semibold">{project.data.title}</h3>
            <span class="text-xs px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">{project.data.status}</span>
          </div>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-4">{project.data.description}</p>
          <div class="flex gap-2">
            {project.data.tags.map(tag => (
              <span class="text-xs font-mono bg-zinc-100 dark:bg-zinc-800 px-2 py-1 rounded text-zinc-700 dark:text-zinc-300">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>