---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const featuredProjects = (await getCollection('projects', ({ data }) => data.featured)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout title="Home" description="Full-stack developer portfolio">
  <section class="py-12 space-y-6">
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">
      Product Manager & Builder<span class="text-blue-500">.</span>
    </h1>
    <p class="text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl">
      Currently crafting showcase systems and documenting the process.
    </p>
    <div class="flex flex-wrap gap-4 pt-2">
      <a href={`${base}/projects`} class="px-5 py-2.5 bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 rounded-md font-medium text-sm hover:opacity-90">
        View Projects
      </a>
      <a href={`${base}/resume`} class="px-5 py-2.5 border border-zinc-300 dark:border-zinc-700 rounded-md font-medium text-sm hover:bg-zinc-100 dark:hover:bg-zinc-900">
        View Resume
      </a>
      <a href={`${base}/contact`} class="px-5 py-2.5 border border-zinc-300 dark:border-zinc-700 rounded-md font-medium text-sm hover:bg-zinc-100 dark:hover:bg-zinc-900">
        Get in Touch
      </a>
    </div>
  </section>

  <section id="about" class="mt-12 space-y-8">
    <div>
      <h2 class="text-2xl font-bold tracking-tight mb-3">About Me</h2>
      <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl">
        Hi, I'm Han. I am a product manager focused on crafting thoughtful user experiences, learning as I go.
        I value code maintainability, clean systems design, and continuous growth.
      </p>
    </div>

    <div>
      <h3 class="text-xl font-bold tracking-tight mb-3">Core Skills</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div class="p-4 border border-zinc-200 dark:border-zinc-800 rounded-lg bg-white dark:bg-zinc-900">
          <h4 class="font-semibold mb-2">Languages</h4>
          <p class="text-zinc-600 dark:text-zinc-400">TypeScript, JavaScript, Go, Python, SQL</p>
        </div>
        <div class="p-4 border border-zinc-200 dark:border-zinc-800 rounded-lg bg-white dark:bg-zinc-900">
          <h4 class="font-semibold mb-2">Frameworks & Tools</h4>
          <p class="text-zinc-600 dark:text-zinc-400">React, Astro, Next.js, Docker, Tailwind CSS</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-16">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold tracking-tight">Featured Projects</h2>
      <a href={`${base}/projects`} class="text-sm text-blue-500 hover:underline">All projects →</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map(project => (
        <a href={`${base}/projects/${project.id}`} class="block p-6 border border-zinc-200 dark:border-zinc-800 rounded-lg hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors bg-white dark:bg-zinc-900">
          <div class="flex justify-between items-start mb-2">
            <h3 class="text-lg font-semibold">{project.data.title}</h3>
            <span class={`text-xs px-2 py-0.5 rounded font-medium ${
              project.data.status === 'Completed'
                ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300'
                : project.data.status === 'In Progress'
                ? 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300'
                : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400'
            }`}>{project.data.status}</span>
          </div>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-4">{project.data.description}</p>
          <div class="flex flex-wrap gap-2">
            {project.data.tags.map(tag => (
              <span class="text-xs font-mono bg-zinc-100 dark:bg-zinc-800 px-2 py-1 rounded text-zinc-700 dark:text-zinc-300">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>