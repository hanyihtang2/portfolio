---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const featuredProjects = (await getCollection('projects', ({ data }) => data.featured)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout title="Home" description="Portfolio of Han-Yih Tang — Product Manager & Engineer, certified Product Owner (PSPO I), and hands-on builder.">
  <!-- Hero Section -->
  <section class="space-y-4">
    <h1 class="type-h1 sm:text-5xl">
      Product Manager &amp; Engineer<span class="text-blue-500">.</span>
    </h1>
    <p class="type-lead max-w-2xl">
      7+ years leading product strategy, roadmap execution, and cross-functional teams — paired with hands-on engineering.
    </p>
  </section>

  <section id="about" class="mt-12 space-y-8">
    <div>
      <h2 class="type-h2 mb-3">About Me</h2>
      <p class="type-body max-w-2xl">
        Hi, I'm Han. I bridge commercial product strategy, agile product ownership (PSPO I), and hands-on development. With a background spanning Product Management, Test Engineering, Business Analysis, and full-stack building, I turn complex problems into verifiable production systems — explore my <a href={`${base}/learning`} class="text-blue-600 dark:text-blue-400 font-medium hover:underline">learning roadmap &amp; timeline →</a>.
      </p>
    </div>

    <!-- Dual-Track Core Competencies Matrix -->
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 border-b border-default pb-2">
        <div>
          <h3 class="type-h3">Dual-Track Capabilities</h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-0.5">
            Bridging strategic product ownership with hands-on technical architecture.
          </p>
        </div>
        <a
          href={`${base}/resume`}
          data-analytics-event="resume_click"
          data-analytics-location="home_dual_track_matrix"
          data-analytics-format="html"
          class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline"
        >
          Full CV &amp; Career History →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        <!-- Track 1: Product Strategy & Leadership -->
        <div class="card-base p-5 sm:p-6 space-y-4">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
            <h4 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 tracking-wide uppercase">
              Product Management &amp; Strategy
            </h4>
          </div>

          <div class="space-y-3.5 text-sm">
            <div>
              <h5 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1">
                Strategy &amp; Discovery
              </h5>
              <p class="text-zinc-700 dark:text-zinc-300 text-xs sm:text-sm leading-relaxed">
                Product Roadmaps, PRD Authoring, OKRs, User Story Mapping, Business Cases.
              </p>
            </div>

            <div>
              <h5 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1">
                Agile &amp; Team Leadership
              </h5>
              <p class="text-zinc-700 dark:text-zinc-300 text-xs sm:text-sm leading-relaxed">
                Certified Scrum Product Owner (PSPO I), Ways-of-Working, Vendor Negotiation.
              </p>
            </div>

            <div>
              <h5 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1">
                Product Design &amp; UX
              </h5>
              <p class="text-zinc-700 dark:text-zinc-300 text-xs sm:text-sm leading-relaxed">
                UX Design, Customer Journey Mapping, Design Systems, Usability Testing, WCAG Compliant Accessibility.
              </p>
            </div>
          </div>
        </div>

        <!-- Track 2: Software Engineering & Architecture -->
        <div class="card-base p-5 sm:p-6 space-y-4">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <h4 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 tracking-wide uppercase">
              Engineering &amp; Architecture
            </h4>
          </div>

          <div class="space-y-3.5 text-sm">
            <div>
              <h5 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1">
                Languages &amp; Core Stack
              </h5>
              <p class="text-zinc-700 dark:text-zinc-300 text-xs sm:text-sm leading-relaxed">
                TypeScript, JavaScript (ES6+), Python, SQL, HTML5 / Semantic Web.
              </p>
            </div>

            <div>
              <h5 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1">
                Frameworks &amp; Runtimes
              </h5>
              <p class="text-zinc-700 dark:text-zinc-300 text-xs sm:text-sm leading-relaxed">
                React 18/19, Next.js (App Router), Expo / React Native, Astro, Tailwind CSS, Vite.
              </p>
            </div>

            <div>
              <h5 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-1">
                Systems, Data &amp; Security
              </h5>
              <p class="text-zinc-700 dark:text-zinc-300 text-xs sm:text-sm leading-relaxed">
                Microservice APIs, PostgreSQL, Supabase RLS, MFA, Networking.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="mt-16">
    <div class="flex justify-between items-center mb-6">
      <h2 class="type-h2">Featured Projects</h2>
      <a href={`${base}/projects`} class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">All Projects &amp; Concepts →</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map(project => (
        <ProjectCard project={project} headingLevel="h3" />
      ))}
    </div>
  </section>
</BaseLayout>