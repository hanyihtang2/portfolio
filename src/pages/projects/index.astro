---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const allProjects = (await getCollection('projects')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout title="Projects" description="All past projects and open source work">
  <div class="mb-10">
    <h1 class="text-3xl font-extrabold tracking-tight mb-2">Projects</h1>
    <p class="text-zinc-600 dark:text-zinc-400">A catalog of systems, tools, and apps I've designed and built.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {allProjects.map(project => (
      <div class="p-6 border border-zinc-200 dark:border-zinc-800 rounded-lg bg-white dark:bg-zinc-900 flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-start mb-2">
            <h2 class="text-xl font-bold">{project.data.title}</h2>
            <span class={`text-xs px-2 py-0.5 rounded font-medium ${
              project.data.status === 'Completed'
                ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300'
                : project.data.status === 'In Progress'
                ? 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300'
                : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400'
            }`}>{project.data.status}</span>
          </div>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-4">{project.data.description}</p>
          <div class="flex flex-wrap gap-2 mb-6">
            {project.data.tags.map(tag => (
              <span class="text-xs font-mono bg-zinc-100 dark:bg-zinc-800 px-2 py-1 rounded text-zinc-600 dark:text-zinc-300">
                {tag}
              </span>
            ))}
          </div>
        </div>
        <div class="flex items-center gap-4 text-sm font-medium border-t border-zinc-100 dark:border-zinc-800 pt-4">
          <a href={`${base}/projects/${project.id}`} class="text-blue-500 hover:underline">Read Case Study →</a>
          {project.data.githubUrl && (
            <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:underline">GitHub ↗</a>
          )}
          {project.data.liveUrl && (
            <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:underline">Live Demo ↗</a>
          )}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>