---
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const counts = {
  all: allProjects.length,
  completed: allProjects.filter((p) => p.data.status === 'Completed').length,
  inProgress: allProjects.filter((p) => p.data.status === 'In Progress').length,
  concept: allProjects.filter((p) => p.data.status === 'Concept').length,
};
---

<PageLayout
  title="Projects"
  description="All past projects and open source work"
  heading="Projects"
  lead="A catalog of systems, tools, and apps I've designed and built."
>
  <div class="space-y-8">
    <!-- Controls Bar: Status Filters -->
    <section class="sticky top-16 z-30 py-3 bg-zinc-50/90 dark:bg-zinc-950/90 backdrop-blur-md border-y border-default flex items-center gap-3">
      <!-- Status Filter Toggle Group (WCAG 1.3.1 / 4.1.2) -->
      <div id="status-filters" class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter projects by status">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-tab active px-3 py-1.5 rounded-lg text-xs font-semibold cursor-pointer transition-all bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 shadow-xs"
        >
          All ({counts.all})
        </button>
        {counts.completed > 0 && (
          <button
            type="button"
            data-filter="Completed"
            aria-pressed="false"
            class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold cursor-pointer transition-all bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border border-default hover:border-emerald-400 dark:hover:border-emerald-500"
          >
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 mr-1.5" aria-hidden="true"></span>
            Completed ({counts.completed})
          </button>
        )}
        {counts.inProgress > 0 && (
          <button
            type="button"
            data-filter="In Progress"
            aria-pressed="false"
            class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold cursor-pointer transition-all bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border border-default hover:border-amber-400 dark:hover:border-amber-500"
          >
            <span class="inline-block w-2 h-2 rounded-full bg-amber-500 mr-1.5 animate-pulse" aria-hidden="true"></span>
            In Progress ({counts.inProgress})
          </button>
        )}
        {counts.concept > 0 && (
          <button
            type="button"
            data-filter="Concept"
            aria-pressed="false"
            class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold cursor-pointer transition-all bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border border-default hover:border-zinc-400 dark:hover:border-zinc-500"
          >
            <span class="inline-block w-2 h-2 rounded-full bg-zinc-400 dark:bg-zinc-500 mr-1.5" aria-hidden="true"></span>
            Concepts ({counts.concept})
          </button>
        )}
      </div>
    </section>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {allProjects.map(project => (
        <ProjectCard project={project} headingLevel="h2" />
      ))}
    </div>

    <!-- No Results State -->
    <div id="no-results" role="status" aria-live="polite" class="hidden text-center py-16 px-4 space-y-3">
      <p class="text-zinc-600 dark:text-zinc-400 text-sm">
        No projects match the selected status filter.
      </p>
      <button
        id="reset-filters-btn"
        type="button"
        class="btn-primary"
      >
        Reset Filters
      </button>
    </div>
  </div>
</PageLayout>

<script is:inline>
  (function () {
    const tabButtons = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll('.project-card');
    const noResults = document.getElementById('no-results');
    const resetBtn = document.getElementById('reset-filters-btn');

    let currentStatus = 'all';

    function applyFilters() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardStatus = card.getAttribute('data-status');
        const statusMatch = currentStatus === 'all' || cardStatus === currentStatus;

        if (statusMatch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    function setActiveTab(selectedTab) {
      tabButtons.forEach((btn) => {
        btn.classList.remove('active', 'bg-zinc-900', 'text-white', 'dark:bg-zinc-100', 'dark:text-zinc-900');
        btn.classList.add('bg-white', 'dark:bg-zinc-900', 'text-zinc-700', 'dark:text-zinc-300');
        btn.setAttribute('aria-pressed', 'false');
      });

      selectedTab.classList.add('active', 'bg-zinc-900', 'text-white', 'dark:bg-zinc-100', 'dark:text-zinc-900');
      selectedTab.classList.remove('bg-white', 'dark:bg-zinc-900', 'text-zinc-700', 'dark:text-zinc-300');
      selectedTab.setAttribute('aria-pressed', 'true');
    }

    tabButtons.forEach((tab) => {
      tab.addEventListener('click', () => {
        setActiveTab(tab);
        currentStatus = tab.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        currentStatus = 'all';
        if (tabButtons.length > 0) {
          setActiveTab(tabButtons[0]);
        }
        applyFilters();
      });
    }

    // Support deep-linking via ?status=Concept, ?status=Completed, etc.
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const paramStatus = urlParams.get('status');
      if (paramStatus) {
        const matchingTab = Array.from(tabButtons).find(
          (btn) => (btn.getAttribute('data-filter') || '').toLowerCase() === paramStatus.toLowerCase()
        );
        if (matchingTab) {
          setActiveTab(matchingTab);
          currentStatus = matchingTab.getAttribute('data-filter') || 'all';
          applyFilters();
        }
      }
    } catch (e) {}
  })();
</script>


