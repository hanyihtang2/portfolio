---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout title="Projects" description="All past projects and open source work">
  <div class="mb-10">
    <h1 class="text-3xl font-extrabold tracking-tight mb-2">Projects</h1>
    <p class="text-zinc-600 dark:text-zinc-400">A catalog of systems, tools, and apps I've designed and built.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {allProjects.map(project => (
      <ProjectCard project={project} headingLevel="h2" />
    ))}
  </div>
</BaseLayout>