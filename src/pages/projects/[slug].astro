---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectTabs from '../../components/ProjectTabs.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const sectionLinks = [
  { id: 'summary', label: 'Summary & Objectives' },
  { id: 'design-process', label: 'Design Process' },
  { id: 'key-metrics', label: 'Key Metrics' },
  { id: 'technical-details', label: 'Technical Details' },
  { id: 'repository', label: 'Repository & Code' },
];

const statusBadgeClasses: Record<string, string> = {
  'Completed': 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-300/60 dark:border-emerald-800/60',
  'In Progress': 'bg-amber-100 text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 border border-amber-300/60 dark:border-amber-800/60',
  'Concept': 'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700',
};

const statusDotClasses: Record<string, string> = {
  'Completed': 'bg-emerald-500',
  'In Progress': 'bg-amber-500',
  'Concept': 'bg-zinc-400',
};
---

<BaseLayout title={data.title} description={data.description}>
  <div>
    <!-- Breadcrumb -->
    <Breadcrumb
      items={[
        { label: "Projects", href: `${base}/projects` },
        { label: data.title },
      ]}
    />

    <!-- Project Header Hero -->
    <header class="pb-8 border-b border-zinc-200 dark:border-zinc-800 space-y-3">
      <!-- Status Eyebrow Badge -->
      <div>
        <span class={`inline-flex items-center gap-1.5 text-xs px-2.5 py-1 rounded-full font-medium ${statusBadgeClasses[data.status] || ''}`}>
          <span class={`w-1.5 h-1.5 rounded-full ${statusDotClasses[data.status] || 'bg-zinc-400'}`} aria-hidden="true"></span>
          {data.status}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
        {data.title}
      </h1>

      <p class="text-xl text-zinc-600 dark:text-zinc-400 max-w-3xl leading-relaxed pt-1">
        {data.description}
      </p>

      <!-- Metadata & Action Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
        <div class="flex flex-wrap items-center gap-4 text-xs text-zinc-500 dark:text-zinc-400">
          {data.role && (
            <div>
              <span class="font-medium text-zinc-700 dark:text-zinc-300">Role:</span> {data.role}
            </div>
          )}
          {data.timeline && (
            <div>
              <span class="font-medium text-zinc-700 dark:text-zinc-300">Timeline:</span> {data.timeline}
            </div>
          )}
          <div>
            <span class="font-medium text-zinc-700 dark:text-zinc-300">Published:</span> {data.publishDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
          </div>
        </div>

        <div class="flex items-center gap-3">
          {data.githubUrl && (
            <a
              href={data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 text-xs font-semibold hover:opacity-90 transition-opacity"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              GitHub Repo
            </a>
          )}
          {data.liveUrl && (
            <a
              href={data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md border border-zinc-300 dark:border-zinc-700 text-xs font-semibold hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
            >
              Live Demo ↗
            </a>
          )}
          {!data.githubUrl && data.status !== 'Concept' && (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
              </svg>
              Private Repository
            </span>
          )}
        </div>
      </div>

      <!-- Tag badges -->
      <div class="flex flex-wrap gap-2 pt-2">
        {data.tags.map((tag: string) => (
          <span class="text-xs font-mono bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 px-2.5 py-1 rounded text-zinc-700 dark:text-zinc-300">
            {tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Sub-Navigation Tabs -->
    <ProjectTabs slug={entry.id} activeTab="overview" />

    <!-- Sticky Single-Scroll Section Quick Navigation -->
    <div class="sticky top-16 z-40 bg-zinc-50/90 dark:bg-zinc-950/90 backdrop-blur-md py-3 border-b border-zinc-200 dark:border-zinc-800 -mx-6 px-6 sm:mx-0 sm:px-0">
      <nav class="flex items-center gap-2 sm:gap-4 overflow-x-auto text-xs sm:text-sm font-medium no-scrollbar" aria-label="Section navigation">
        <span class="text-zinc-400 text-xs uppercase tracking-wider font-semibold mr-1 hidden md:inline">Jump to:</span>
        {sectionLinks.map((sec) => (
          <a
            href={`#${sec.id}`}
            class="px-2.5 py-1 rounded-md text-zinc-600 dark:text-zinc-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors whitespace-nowrap"
          >
            {sec.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Structured Key Metrics Cards (if defined in frontmatter) -->
    {data.metrics && data.metrics.length > 0 && (
      <div class="my-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
        {data.metrics.map((m: { label: string; value: string; description?: string }) => (
          <div class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
            <div class="text-2xl sm:text-3xl font-extrabold text-blue-600 dark:text-blue-400 tracking-tight">
              {m.value}
            </div>
            <div class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 mt-1">
              {m.label}
            </div>
            {m.description && (
              <div class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">
                {m.description}
              </div>
            )}
          </div>
        ))}
      </div>
    )}

    <!-- Structured Technical Details Grid (if defined in frontmatter) -->
    {data.techStack && (
      <div class="my-8 p-6 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 space-y-4">
        <h3 class="text-sm font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
          Technology Breakdown
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
          {data.techStack.languages && (
            <div>
              <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 block mb-1.5">Languages</span>
              <div class="flex flex-wrap gap-1.5">
                {data.techStack.languages.map((item: string) => (
                  <span class="text-xs px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 font-mono text-zinc-700 dark:text-zinc-300 border border-zinc-200/60 dark:border-zinc-700/60">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          )}
          {data.techStack.frameworks && (
            <div>
              <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 block mb-1.5">Frameworks & Libs</span>
              <div class="flex flex-wrap gap-1.5">
                {data.techStack.frameworks.map((item: string) => (
                  <span class="text-xs px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 font-mono text-zinc-700 dark:text-zinc-300 border border-zinc-200/60 dark:border-zinc-700/60">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          )}
          {data.techStack.infrastructure && (
            <div>
              <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 block mb-1.5">Infrastructure</span>
              <div class="flex flex-wrap gap-1.5">
                {data.techStack.infrastructure.map((item: string) => (
                  <span class="text-xs px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 font-mono text-zinc-700 dark:text-zinc-300 border border-zinc-200/60 dark:border-zinc-700/60">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          )}
          {data.techStack.tools && (
            <div>
              <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 block mb-1.5">Tools & Testing</span>
              <div class="flex flex-wrap gap-1.5">
                {data.techStack.tools.map((item: string) => (
                  <span class="text-xs px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 font-mono text-zinc-700 dark:text-zinc-300 border border-zinc-200/60 dark:border-zinc-700/60">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- UI Mockup Preview (if defined in frontmatter) -->
    {(data.mockupImage || data.mobileMockupImage) && (
      <section id="ui-mockup" class="my-8 space-y-4">
        <div class={`grid grid-cols-1 ${data.mockupImage && data.mobileMockupImage ? 'lg:grid-cols-3 items-start' : ''} gap-6`}>
          {data.mockupImage && (
            <figure class={`${data.mobileMockupImage ? 'lg:col-span-2' : ''} rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden shadow-xs`}>
              <div class="flex items-center justify-between px-4 py-2.5 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/60">
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-400/80"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></span>
                </div>
                <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
                  Desktop UI — {data.title}
                </span>
                <a
                  href={`${base}${data.mockupImage}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline"
                >
                  Full Size ↗
                </a>
              </div>
              <div class="p-2 sm:p-4 bg-zinc-100/60 dark:bg-zinc-950/40">
                <img
                  src={`${base}${data.mockupImage}`}
                  alt={`${data.title} Desktop UI Mockup`}
                  loading="lazy"
                  class="w-full h-auto rounded-lg border border-zinc-200/80 dark:border-zinc-800/80"
                />
              </div>
              {data.mockupCaption && (
                <figcaption class="px-5 py-3 text-xs text-zinc-600 dark:text-zinc-400 border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
                  <strong class="text-zinc-800 dark:text-zinc-200">Desktop Layout:</strong> {data.mockupCaption}
                </figcaption>
              )}
            </figure>
          )}

          {data.mobileMockupImage && (
            <figure class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden shadow-xs max-w-xs mx-auto lg:max-w-none w-full">
              <div class="flex items-center justify-between px-4 py-2.5 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/60">
                <span class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-500 dark:text-zinc-400">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="7" y="2" width="10" height="20" rx="2" ry="2" />
                    <line x1="12" y1="18" x2="12.01" y2="18" />
                  </svg>
                  Mobile UI
                </span>
                <a
                  href={`${base}${data.mobileMockupImage}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline"
                >
                  Full Size ↗
                </a>
              </div>
              <div class="p-3 bg-zinc-100/60 dark:bg-zinc-950/40 flex justify-center">
                <img
                  src={`${base}${data.mobileMockupImage}`}
                  alt={`${data.title} Mobile UI Mockup`}
                  loading="lazy"
                  class="max-h-96 w-auto rounded-lg border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs"
                />
              </div>
              {data.mobileMockupCaption && (
                <figcaption class="px-5 py-3 text-xs text-zinc-600 dark:text-zinc-400 border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
                  <strong class="text-zinc-800 dark:text-zinc-200">Mobile-First View:</strong> {data.mobileMockupCaption}
                </figcaption>
              )}
            </figure>
          )}
        </div>
      </section>
    )}

    <!-- Markdown Narrative (Single Scrollable Case Study Body) -->
    <article class="project-prose mt-8 max-w-3xl">
      <Content />
    </article>

    <!-- Roadmap Callout Banner -->
    {data.roadmap && data.roadmap.length > 0 && (
      <div class="mt-12 p-6 rounded-xl border border-blue-200 dark:border-blue-900/60 bg-blue-50/50 dark:bg-blue-950/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Product Architecture & Milestones
          </span>
          <h3 class="text-base font-bold text-zinc-900 dark:text-zinc-100 mt-0.5">
            Explore the {data.title} Product Roadmap
          </h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1">
            See planned release milestones, completed deliverables, and upcoming architecture phases.
          </p>
        </div>
        <a
          href={`${base}/projects/${entry.id}/roadmap`}
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md bg-blue-600 text-white hover:bg-blue-700 text-xs font-semibold whitespace-nowrap transition-colors flex-shrink-0"
        >
          <span>View Roadmap ({data.roadmap.length} Phases)</span>
          <span>→</span>
        </a>
      </div>
    )}

    <!-- Dedicated GitHub Repository Section (#repository) -->
    <section id="repository" class="mt-16 pt-8 border-t border-zinc-200 dark:border-zinc-800">
      <div class="p-6 sm:p-8 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <div class="flex items-center gap-2">
            <svg class="w-6 h-6 fill-current text-zinc-800 dark:text-zinc-200" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-100">Source Code & Repository</h2>
          </div>
          {data.githubUrl ? (
            <>
              <p class="text-sm text-zinc-600 dark:text-zinc-400">
                Explore the complete codebase, commits, architecture documentation, and run the project locally.
              </p>
              <div class="pt-1">
                <code class="text-xs font-mono bg-zinc-100 dark:bg-zinc-800 px-3 py-1.5 rounded border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 select-all block sm:inline-block">
                  git clone {data.githubUrl}.git
                </code>
              </div>
            </>
          ) : data.status === 'Concept' ? (
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              This project is currently in the <strong>Concept & Architecture Design</strong> stage. The public GitHub repository will be linked here once initial scaffolding begins.
            </p>
          ) : data.liveUrl ? (
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              This codebase is currently maintained in a <strong>private repository</strong>, with the web application actively deployed on Cloudflare Pages and accessible via the live demo link. Code access or an architecture walkthrough is available upon request.
            </p>
          ) : (
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              This repository is currently <strong>private</strong>. Code access or an architecture walkthrough is available upon request.
            </p>
          )}
        </div>

        {(data.githubUrl || data.liveUrl) ? (
          <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
            {data.liveUrl && (
              <a
                href={data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 text-zinc-900 dark:text-zinc-100 font-semibold text-sm hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors text-center inline-flex items-center justify-center gap-2 w-full sm:w-auto"
              >
                Live Demo ↗
              </a>
            )}
            {data.githubUrl && (
              <a
                href={data.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-2.5 rounded-lg bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 font-semibold text-sm hover:opacity-90 transition-opacity text-center inline-flex items-center justify-center gap-2 w-full sm:w-auto"
              >
                Open in GitHub ↗
              </a>
            )}
            {!data.githubUrl && data.status !== 'Concept' && (
              <span class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-lg text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700 whitespace-nowrap">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                </svg>
                Private Repository
              </span>
            )}
          </div>
        ) : data.status !== 'Concept' ? (
          <div class="flex items-center">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
              </svg>
              Private Repository
            </span>
          </div>
        ) : null}
      </div>
    </section>

    <!-- Bottom Navigation Footer -->
    <div class="mt-12 pt-6 border-t border-zinc-200 dark:border-zinc-800 flex justify-between items-center text-sm font-medium">
      <a href={`${base}/projects`} class="text-blue-600 dark:text-blue-400 hover:underline">
        ← Back to all projects
      </a>
