---
import { getCollection, render } from 'astro:content';
import ProjectDetailLayout from '../../layouts/ProjectDetailLayout.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function formatNavLabel(text: string): string {
  const cleaned = text.replace(/^\d+[\.\)]\s*/, '').trim();
  if (/summary|overview|problem/i.test(cleaned)) return 'Summary & Objectives';
  if (/design|architecture|ui design/i.test(cleaned)) return 'Design Process';
  if (/metric|outcome|kpi|capabilities/i.test(cleaned)) return 'Key Metrics';
  if (/technical|implementation/i.test(cleaned)) return 'Technical Details';
  if (/quickstart|deployment|workspace/i.test(cleaned)) return 'Quickstart';
  if (/roadmap|status/i.test(cleaned)) return 'Roadmap';
  return cleaned.split(/[,&]/)[0].trim();
}

const navHeadings = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({
    id: h.slug,
    label: formatNavLabel(h.text),
  }));

const sectionLinks = [
  ...navHeadings,
  { id: 'repository', label: 'Repository & Code' },
];
---

<ProjectDetailLayout entry={entry} activeTab="overview">

    <!-- Sticky Single-Scroll Section Quick Navigation -->
    <div class="sticky top-16 z-40 bg-zinc-50/90 dark:bg-zinc-950/90 backdrop-blur-md py-3 border-b border-default -mx-6 px-6 sm:mx-0 sm:px-0">
      <nav class="flex items-center gap-2 sm:gap-4 overflow-x-auto text-xs sm:text-sm font-medium no-scrollbar py-0.5" aria-label="Section navigation">
        <span class="text-zinc-400 text-xs uppercase tracking-wider font-semibold mr-1 hidden md:inline shrink-0 whitespace-nowrap">Jump to:</span>
        {sectionLinks.map((sec) => (
          <a
            href={`#${sec.id}`}
            class="px-2.5 py-1 rounded-md text-zinc-600 dark:text-zinc-400 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors whitespace-nowrap"
          >
            {sec.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Structured Key Metrics Cards (if defined in frontmatter) -->
    {data.metrics && data.metrics.length > 0 && (
      <div class="my-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
        {data.metrics.map((m: { label: string; value: string; description?: string }) => (
          <div class="card-compact">
            <div class="text-2xl sm:text-3xl font-extrabold text-blue-600 dark:text-blue-400 tracking-tight">
              {m.value}
            </div>
            <div class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 mt-1">
              {m.label}
            </div>
            {m.description && (
              <div class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">
                {m.description}
              </div>
            )}
          </div>
        ))}
      </div>
    )}

    <!-- Structured Technical Details Grid (if defined in frontmatter) -->
    {data.techStack && (
      <div class="card-base my-8 p-6 space-y-4">
        <h3 class="type-eyebrow">
          Technology Breakdown
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          {data.techStack.languages && (
            <div class="min-w-0">
              <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 block mb-1.5">Languages</span>
              <div class="flex flex-wrap gap-1.5">
                {data.techStack.languages.map((item: string) => (
                  <span class="tag-pill" title={item}>{item}</span>
                ))}
              </div>
            </div>
          )}
          {data.techStack.frameworks && (
            <div class="min-w-0">
              <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 block mb-1.5">Frameworks & Libs</span>
              <div class="flex flex-wrap gap-1.5">
                {data.techStack.frameworks.map((item: string) => (
                  <span class="tag-pill" title={item}>{item}</span>
                ))}
              </div>
            </div>
          )}
          {data.techStack.infrastructure && (
            <div class="min-w-0">
              <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 block mb-1.5">Infrastructure</span>
              <div class="flex flex-wrap gap-1.5">
                {data.techStack.infrastructure.map((item: string) => (
                  <span class="tag-pill" title={item}>{item}</span>
                ))}
              </div>
            </div>
          )}
          {data.techStack.tools && (
            <div class="min-w-0">
              <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 block mb-1.5">Tools & Testing</span>
              <div class="flex flex-wrap gap-1.5">
                {data.techStack.tools.map((item: string) => (
                  <span class="tag-pill" title={item}>{item}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- UI Mockup Preview (if defined in frontmatter) -->
    {(data.mockupImage || data.mobileMockupImage) && (
      <section id="ui-mockup" class="my-8 space-y-4">
        <div class={`grid grid-cols-1 ${data.mockupImage && data.mobileMockupImage ? 'lg:grid-cols-3 items-start' : ''} gap-6`}>
          {data.mockupImage && (
            <figure class={`${data.mobileMockupImage ? 'lg:col-span-2' : ''} card-base overflow-hidden`}>
              <div class="flex items-center justify-between px-4 py-2.5 border-b border-default surface-muted">
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-400/80"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-400/80"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/80"></span>
                </div>
                <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
                  Desktop UI — {data.title}
                </span>
                <a
                  href={`${base}${data.mockupImage}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline"
                >
                  Full Size ↗
                </a>
              </div>
              <div class="p-2 sm:p-4 bg-zinc-100/60 dark:bg-zinc-950/40">
                <img
                  src={`${base}${data.mockupImage}`}
                  alt={`${data.title} Desktop UI Mockup`}
                  width="1024"
                  height="491"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto rounded-lg border border-subtle"
                />
              </div>
              {data.mockupCaption && (
                <figcaption class="px-5 py-3 text-xs text-zinc-600 dark:text-zinc-400 border-t border-default surface-card">
                  <strong class="text-zinc-800 dark:text-zinc-200">Desktop Layout:</strong> {data.mockupCaption}
                </figcaption>
              )}
            </figure>
          )}

          {data.mobileMockupImage && (
            <figure class="card-base overflow-hidden max-w-xs mx-auto lg:max-w-none w-full">
              <div class="flex items-center justify-between px-4 py-2.5 border-b border-default surface-muted">
                <span class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-500 dark:text-zinc-400">
                  <Icon name="device-mobile" class="w-3.5 h-3.5" />
                  Mobile UI
                </span>
                <a
                  href={`${base}${data.mobileMockupImage}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline"
                >
                  Full Size ↗
                </a>
              </div>
              <div class="p-3 bg-zinc-100/60 dark:bg-zinc-950/40 flex justify-center">
                <img
                  src={`${base}${data.mobileMockupImage}`}
                  alt={`${data.title} Mobile UI Mockup`}
                  width="368"
                  height="645"
                  loading="lazy"
                  decoding="async"
                  class="max-h-96 w-auto rounded-lg border border-subtle shadow-xs"
                />
              </div>
              {data.mobileMockupCaption && (
                <figcaption class="px-5 py-3 text-xs text-zinc-600 dark:text-zinc-400 border-t border-default surface-card">
                  <strong class="text-zinc-800 dark:text-zinc-200">Mobile-First View:</strong> {data.mobileMockupCaption}
                </figcaption>
              )}
            </figure>
          )}
        </div>
      </section>
    )}

    <!-- Markdown Narrative (Single Scrollable Case Study Body) -->
    <article class="project-prose mt-8 max-w-3xl">
      <Content />
    </article>

    <!-- Roadmap Callout Banner -->
    {data.roadmap && data.roadmap.length > 0 && (
      <div class="mt-12 p-6 rounded-xl border border-blue-200 dark:border-blue-900/60 bg-blue-50/50 dark:bg-blue-950/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Product Architecture & Milestones
          </span>
          <h3 class="type-h4 mt-0.5">
            Explore the {data.title} Product Roadmap
          </h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1">
            See planned release milestones, completed deliverables, and upcoming architecture phases.
          </p>
        </div>
        <a
          href={`${base}/projects/${entry.id}/roadmap`}
          class="btn-accent"
        >
          <span>View Roadmap ({data.roadmap.length} Phases)</span>
          <span>→</span>
        </a>
      </div>
    )}

    <!-- Dedicated GitHub Repository Section (#repository) -->
    <section id="repository" class="mt-16 pt-8 border-t border-default">
      <div class="card-base p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <div class="flex items-center gap-2">
            <Icon name="github" class="w-6 h-6 fill-current text-zinc-800 dark:text-zinc-200" />
            <h2 class="type-h2">Source Code & Repository</h2>
          </div>
          {data.githubUrl ? (
            <>
              <p class="text-sm text-zinc-600 dark:text-zinc-400">
                Explore the complete codebase, commits, architecture documentation, and run the project locally.
              </p>
              <div class="pt-1">
                <code class="text-xs font-mono bg-zinc-100 dark:bg-zinc-800 px-3 py-1.5 rounded border border-default text-zinc-700 dark:text-zinc-300 select-all block sm:inline-block">
                  git clone {data.githubUrl}.git
                </code>
              </div>
            </>
          ) : data.status === 'Concept' ? (
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              This project is currently in the <strong>Concept & Architecture Design</strong> stage. The public GitHub repository will be linked here once initial scaffolding begins.
            </p>
          ) : data.liveUrl ? (
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              This codebase is currently maintained in a <strong>private repository</strong>, with the web application actively deployed on Cloudflare Pages and accessible via the live demo link.
            </p>
          ) : (
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              This repository is currently <strong>private</strong>.
            </p>
          )}
        </div>

        {(data.githubUrl || data.liveUrl) ? (
          <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
            {data.liveUrl && (
              <a
                href={data.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary text-center inline-flex items-center justify-center gap-2 w-full sm:w-auto"
              >
                Live Demo ↗
              </a>
            )}
            {data.githubUrl && (
              <a
                href={data.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary text-center inline-flex items-center justify-center gap-2 w-full sm:w-auto"
              >
                Open in GitHub ↗
              </a>
            )}
            {!data.githubUrl && data.status !== 'Concept' && (
              <span class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-lg text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-default whitespace-nowrap">
                <Icon name="lock" class="w-4 h-4 fill-current" />
                Private Repository
              </span>
            )}
          </div>
        ) : data.status !== 'Concept' ? (
          <div class="flex items-center">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-default">
              <Icon name="lock" class="w-4 h-4 fill-current" />
              Private Repository
            </span>
          </div>
        ) : null}
      </div>
    </section>

    <!-- Bottom Navigation Footer -->
    <div class="mt-12 pt-6 border-t border-default flex justify-between items-center text-sm font-medium">
      <a href={`${base}/projects`} class="text-blue-600 dark:text-blue-400 hover:underline">
        ← Back to All Projects &amp; Concepts
      </a>
      <a href="#main-content" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200">
        ↑ Back to top
      </a>
    </div>
</ProjectDetailLayout>