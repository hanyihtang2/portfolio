---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectTabs from '../../../components/ProjectTabs.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import Icon from '../../../components/Icon.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const roadmapItems = data.roadmap || [];
const completedCount = roadmapItems.filter((i) => i.status === 'Completed').length;
const inProgressCount = roadmapItems.filter((i) => i.status === 'In Progress').length;
const plannedCount = roadmapItems.filter((i) => i.status === 'Planned').length;
---

<BaseLayout
  title={`${data.title} - Product Roadmap`}
  description={`Architecture roadmap, planned development phases, and milestone deliverables for ${data.title}.`}
>
  <div>
    <!-- Breadcrumb -->
    <Breadcrumb
      items={[
        { label: "Projects", href: `${base}/projects` },
        { label: data.title, href: `${base}/projects/${entry.id}` },
        { label: "Roadmap" },
      ]}
    />

    <!-- Project Header Hero -->
    <header class="pb-6 border-b border-default space-y-3">
      <!-- Status Eyebrow Badge -->
      <div>
        <StatusBadge status={data.status} size="md" showDot={true} />
      </div>

      <h1 class="type-h1">
        {data.title} Roadmap
      </h1>

      <p class="type-lead max-w-3xl pt-1">
        Planned architectural phases, key deliverables, and target milestone trajectory for {data.title}.
      </p>

      <!-- Metadata & Action Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
        <div class="flex flex-wrap items-center gap-4 text-xs text-zinc-500 dark:text-zinc-400">
          {data.role && (
            <div>
              <span class="font-medium text-zinc-700 dark:text-zinc-300">Role:</span> {data.role}
            </div>
          )}
          {data.timeline && (
            <div>
              <span class="font-medium text-zinc-700 dark:text-zinc-300">Timeline:</span> {data.timeline}
            </div>
          )}
          <div>
            <span class="font-medium text-zinc-700 dark:text-zinc-300">Published:</span> {data.publishDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
          </div>
        </div>

        <div class="flex items-center gap-3">
          {data.githubUrl && (
            <a
              href={data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              <Icon name="github" class="w-4 h-4 fill-current" />
              GitHub Repo
            </a>
          )}
          {data.liveUrl && (
            <a
              href={data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              Live Demo ↗
            </a>
          )}
          {!data.githubUrl && data.status !== 'Concept' && (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700">
              <Icon name="lock" class="w-3.5 h-3.5 fill-current" />
              Private Repository
            </span>
          )}
        </div>
      </div>
    </header>

    <!-- Sub-Navigation Tabs -->
    <ProjectTabs slug={entry.id} activeTab="roadmap" />

    <!-- Roadmap Statistics Summary -->
    {roadmapItems.length > 0 && (
      <div class="my-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="card-compact">
          <div class="text-2xl sm:text-3xl font-extrabold text-blue-600 dark:text-blue-400 tracking-tight">
            {roadmapItems.length}
          </div>
          <div class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 mt-1">
            Total Phases
          </div>
          <div class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">
            Planned milestones
          </div>
        </div>

        <div class="card-compact">
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 tracking-tight">
            {completedCount}
          </div>
          <div class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 mt-1">
            Completed
          </div>
          <div class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">
            Shipped to production
          </div>
        </div>

        <div class="card-compact">
          <div class="text-2xl sm:text-3xl font-extrabold text-amber-600 dark:text-amber-400 tracking-tight">
            {inProgressCount}
          </div>
          <div class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 mt-1">
            In Progress
          </div>
          <div class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">
            Actively being built
          </div>
        </div>

        <div class="card-compact">
          <div class="text-2xl sm:text-3xl font-extrabold text-zinc-600 dark:text-zinc-400 tracking-tight">
            {plannedCount}
          </div>
          <div class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 mt-1">
            Planned
          </div>
          <div class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">
            Upcoming architectural phases
          </div>
        </div>
      </div>
    )}

    <!-- Roadmap Timeline Narrative -->
    {roadmapItems.length > 0 ? (
      <div class="mt-8 space-y-6">
        {roadmapItems.map((milestone) => (
          <article class="card-base p-6 sm:p-7">
            <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-subtle">
              <div class="flex items-center gap-2.5">
                <span class="tag-pill-accent">
                  {milestone.phase}
                </span>
                {milestone.targetQuarter && (
                  <span class="text-xs font-medium text-zinc-500 dark:text-zinc-400">
                    Target: <strong class="text-zinc-700 dark:text-zinc-300">{milestone.targetQuarter}</strong>
                  </span>
                )}
              </div>

              <StatusBadge status={milestone.status} size="md" showIcon={true} />
            </div>

            <div class="mt-4">
              <h2 class="type-h2">
                {milestone.title}
              </h2>
              <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                {milestone.summary}
              </p>
            </div>

            {milestone.deliverables && milestone.deliverables.length > 0 && (
              <div class="mt-5 pt-4 border-t border-subtle">
                <span class="type-eyebrow block mb-2.5">
                  Milestone Deliverables & Acceptance Criteria
                </span>
                <ul class="space-y-2 text-sm text-zinc-700 dark:text-zinc-300">
                  {milestone.deliverables.map((item) => (
                    <li class="flex items-start gap-2.5">
                      <span class={`mt-1 flex-shrink-0 w-3.5 h-3.5 rounded-full flex items-center justify-center text-[10px] ${
                        milestone.status === 'Completed'
                          ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300'
                          : milestone.status === 'In Progress'
                          ? 'bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300'
                          : 'bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400'
                      }`}>
                        {milestone.status === 'Completed' ? '✓' : '•'}
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))}
      </div>
    ) : (
      <div class="card-base my-16 text-center p-12">
        <h3 class="type-h3">Roadmap In Formulation</h3>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-2 max-w-md mx-auto">
          The milestone breakdown and technical phases for this project are currently being drafted. Check back soon!
        </p>
        <a
          href={`${base}/projects/${entry.id}`}
          class="btn-primary mt-6"
        >
          Return to Case Study
        </a>
      </div>
    )}

    <!-- Bottom Navigation Footer -->
    <div class="mt-12 pt-6 border-t border-default flex justify-between items-center text-sm font-medium">
      <a href={`${base}/projects/${entry.id}`} class="text-blue-600 dark:text-blue-400 hover:underline">
        ← Back to {data.title} Case Study
      </a>
      <a href={`${base}/projects`} class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200">
        Back to all projects →
      </a>
    </div>
  </div>
</BaseLayout>
