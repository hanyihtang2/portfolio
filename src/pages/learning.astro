---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

interface LearningItem {
  id: string;
  title: string;
  phase: 'current' | 'future' | 'past';
  status: 'In Progress' | 'Target / Upcoming' | 'Completed';
  period: string;
  provider: string;
  category: 'Networking & Systems' | 'AI & Agentic Systems' | 'Cloud & Architecture' | 'Security & Governance' | 'Product & UX' | 'Computer Science' | 'Creative Writing' | 'Language Learning' | 'Automotive & Mechanical' | 'Home Systems & Maintenance' | 'Woodworking & Carpentry' | 'Game Development';
  what: string;
  why: string;
  topics: string[];
  link?: {
    label: string;
    url: string;
    external?: boolean;
  };
}

const learningItems: LearningItem[] = [
  // --- CURRENT PURSUITS ---
  {
    id: "ccna-200-301",
    title: "CCNA 200-301 Version 1.1 Specialization",
    phase: "current",
    status: "In Progress",
    period: "Late 2026 – Present (Exam Target: Q1 2027)",
    provider: "Pearson (7-Course Specialization on Coursera)",
    category: "Networking & Systems",
    what: "Pursuing the comprehensive 7-course Pearson specialization aligned with the updated Cisco CCNA 200-301 v1.1 blueprint. Curriculum spans network components and topologies (spine-leaf, three-tier, SOHO), inter-switch communication (VLANs, 802.1Q trunking, Rapid PVST+, EtherChannel), IPv4/IPv6 VLSM subnetting and dynamic routing (OSPFv2), wireless architecture (WLCs, 802.11, WPA3), essential IP services (NAT/PAT, DHCP, DNS, NTP, SNMP, QoS queuing), network security (ACLs, Layer 2 port security/DAI/DHCP snooping, AAA, VPNs), and network automation (SDN, Cisco DNA/Catalyst Center, REST APIs with JSON/YAML).",
    why: "Having delivered 2FA microservice platforms and high-availability digital portals, software reliability and security are inextricably tied to network mechanics. Mastering low-level packet traversal, DNS latency, TLS handshake overhead, and subnet segmentation enables high-conviction architectural debates with network engineering teams and prevents premature abstraction leaks.",
    topics: ["IPv4 / IPv6 Subnetting", "OSPFv2 Dynamic Routing", "VLANs & 802.1Q Trunking", "Spanning Tree & EtherChannel", "ACLs & Layer 2 Security", "SDN & Network Automation"],
    link: {
      label: "View Pearson Coursera Specialization ↗",
      url: "https://www.coursera.org/specializations/pearson-ccna-200-301-version-1-1",
      external: true,
    },
  },
  {
    id: "agentic-ai-systems",
    title: "Agentic AI Architectures & Model Context Protocol (MCP)",
    phase: "current",
    status: "In Progress",
    period: "Late 2026 – Present",
    provider: "Open Source Ecosystem & Applied Engineering",
    category: "AI & Agentic Systems",
    what: "Architecting autonomous agent loops, tool-calling schemas, and context window orchestration using the Model Context Protocol (MCP). Investigating deterministic verification harnesses, ReAct reasoning loops, long-term memory persistence (vector databases and structured state stores), and guardrail architectures to prevent hallucination cascades.",
    why: "Software UX is undergoing a foundational transition from reactive point-and-click graphical interfaces to proactive, autonomous agent workflows. As a product builder, mastering agent orchestration primitives, tool interfaces, and evaluative guardrails is vital to designing software that operates autonomously without sacrificing user trust or deterministic reliability.",
    topics: ["Model Context Protocol (MCP)", "ReAct Loops", "Deterministic Tool Calling", "Vector Retrieval & Memory", "Guardrails & Evals", "Multi-Agent Orchestration"],
  },

  // --- FUTURE HORIZONS ---
  {
    id: "game-development-foundations",
    title: "2D Action Roguelike & Game Systems Engineering",
    phase: "future",
    status: "Target / Upcoming",
    period: "Future Horizon",
    provider: "Self-Directed Game Engineering & Prototyping",
    category: "Game Development",
    what: "Exploring the foundational technical architectures, engine pipelines, and real-time systems behind 2D top-down action games (inspired by titles like The Binding of Isaac). Prototyping core mechanics in a modern lightweight engine (such as Godot 4): real-time game loops, deterministic tick management, 2D kinematic movement and collision detection, object pooling for high-density projectile patterns, room-graph procedural dungeon generation, finite state machines (FSM) for enemy AI, and extensible data-driven item synergy/modifier pipelines.",
    why: "Unlike the distributed cloud services, web applications, and AI agent architectures that dominate my software work, game development operates on fundamentally different systems intuition: hard 16.6ms frame budgets, continuous spatial math, and deeply compounded state interactions where dozens of dynamic modifiers alter base stats and projectile behaviors simultaneously. Venturing into game systems engineering is a creative and technical pursuit to master real-time interactive paradigms from the ground up.",
    topics: ["2D Game Engines (Godot 4)", "Procedural Dungeon Generation", "Item Synergy Architectures", "Finite State Machines (FSM)", "Object Pooling & Frame Budgets", "2D Physics & Collision"],
  },
  {
    id: "ztca-zero-trust",
    title: "ZTCA — Zero Trust Cyber Associate",
    phase: "future",
    status: "Target / Upcoming",
    period: "Target: 2027",
    provider: "Zscaler Cyber Academy",
    category: "Security & Governance",
    what: "Pursuing the industry-recognized ZTCA credential focusing on modern cloud-native Zero Trust Architecture (ZTA) and the Zscaler Zero Trust Exchange™ platform. Core syllabus covers the paradigm shift from legacy network perimeters (VPNs, firewalls) to identity-brokered least-privilege connectivity, application microsegmentation to eliminate lateral attack movement, cloud proxy architectures (Zscaler Internet Access / ZIA, Zscaler Private Access / ZPA, Zscaler Digital Experience / ZDX), and secure SSL/TLS traffic inspection at scale.",
    why: "Having designed PSD2 SCA authentication frameworks and microservices, enterprise application security is fundamentally shifting from perimeter network trust to identity-brokered Zero Trust Network Access (ZTNA). Mastering Zero Trust blueprints bridges network security directly into digital product strategy, enabling friction-free user access while eliminating legacy VPN vulnerabilities.",
    topics: ["Zero Trust Architecture (ZTA)", "Zscaler Zero Trust Exchange", "ZTNA & Private Access (ZPA)", "Cloud Security Proxy (ZIA)", "Application Microsegmentation", "Identity-Based Least Privilege"],
    link: {
      label: "View Zscaler ZTCA Certification ↗",
      url: "https://www.zscaler.com/zscaler-cyber-academy/ztca-zero-trust-cyber-associate",
      external: true,
    },
  },
  {
    id: "fiction-book-writing",
    title: "Writing a Fictional Book (Sci-Fi & Fantasy)",
    phase: "future",
    status: "Target / Upcoming",
    period: "Future Horizon",
    provider: "Self-Directed Creative Project",
    category: "Creative Writing",
    what: "Drafting an original long-form speculative fiction novel rooted in science fiction and fantasy. The project explores narrative architecture, immersive worldbuilding and lore, character development arcs, pacing, and navigating the end-to-end discipline of drafting and revising a full-length manuscript.",
    why: "At face value, this is very different from the structured learning and technology-focused certifications that make up the rest of my roadmap. Having grown up reading a lot of fantasy and science fiction, writing a book is something deeply personal and engaging. It is pursued not for commercial success, but for the creative experience, narrative craft, and personal growth.",
    topics: ["Speculative Fiction", "Science Fiction & Fantasy", "Worldbuilding & Lore", "Narrative Architecture", "Character Development", "Creative Discipline"],
  },
  {
    id: "mandarin-language-acquisition",
    title: "Mandarin Chinese Language Acquisition",
    phase: "future",
    status: "Target / Upcoming",
    period: "Future Horizon",
    provider: "Self-Directed & Immersive Language Study",
    category: "Language Learning",
    what: "Rebuilding and systematically advancing proficiency in Mandarin Chinese from the ground up: mastering tones and Pinyin pronunciation, conversational fluency for daily and family life, core vocabulary acquisition, and reading/writing Chinese characters (Hanzi). Moving beyond elementary familiarity toward confident, natural spoken communication.",
    why: "I learned basic Mandarin and French when I was younger, but never pursued them properly and have forgotten much of what I learned. Learning Mandarin properly is a deeply personal and meaningful priority, especially with much of my extended family living in Malaysia. Rebuilding fluency is about reconnecting with heritage and engaging authentically with family across generations.",
    topics: ["Mandarin Chinese", "Conversational Fluency", "Tones & Pinyin", "Character Literacy (Hanzi)", "Heritage & Family Connection", "Language Acquisition"],
  },
  {
    id: "basic-car-maintenance",
    title: "Basic Car Maintenance & Mechanical Systems",
    phase: "future",
    status: "Target / Upcoming",
    period: "Future Horizon",
    provider: "Hands-On Practical Study & Workshop Experience",
    category: "Automotive & Mechanical",
    what: "Mastering practical automotive maintenance for internal combustion engine (ICE) platforms: essential fluid checks and service (engine oil, coolant, brake fluid), brake inspection and pad replacement, battery diagnostics and electrical basics, tire maintenance and rotations, spark plug and filter changes, and introductory OBD-II diagnostic scanning.",
    why: "While electric vehicles are growing massively, there are still thousands of internal combustion engine platform cars on the road. Understanding basic maintenance remains a valuable, enduring life skill that demystifies mechanical systems and builds a grounded electro-mechanical baseline that can be adapted to future drivetrain platforms.",
    topics: ["ICE Platforms", "Fluid Systems & Filters", "Brake & Tire Servicing", "OBD-II Diagnostics", "Electromechanical Basics", "Drivetrain Fundamentals"],
  },
  {
    id: "electric-vehicle-foundations",
    title: "Foundations of Electric Vehicles (EVs)",
    phase: "future",
    status: "Target / Upcoming",
    period: "Future Horizon",
    provider: "Self-Directed Technical Study & Industry Research",
    category: "Automotive & Mechanical",
    what: "Exploring the foundational engineering and operating principles of electric vehicles (EVs): high-voltage battery pack architecture, electric drivetrain mechanics, power electronics and inverters, thermal management loops, charging standards, and regenerative braking. Scope is intentionally kept adaptable and will be refined as study progresses.",
    why: "Directly builds upon practical car maintenance and mechanical systems fundamentals. As automotive platforms transition toward electrification and software-defined architectures, developing a structured understanding of EV powertrains bridges physical hardware intuition with modern high-voltage and embedded systems.",
    topics: ["Electric Vehicles (EVs)", "High-Voltage Systems", "Battery Architecture", "Electric Drivetrains", "Power Electronics", "Charging Infrastructure"],
  },
  {
    id: "residential-plumbing",
    title: "Foundations of Residential Plumbing",
    phase: "future",
    status: "Target / Upcoming",
    period: "Future Horizon",
    provider: "Hands-On Practical Study & Home Maintenance",
    category: "Home Systems & Maintenance",
    what: "Developing a functional understanding of domestic plumbing systems: supply line materials (copper, PEX) and shutoff valves, pressure regulation, fixture maintenance and installation (faucets, showerheads, toilet valves), drain-waste-vent (DWV) piping and P-traps, unblocking clogs, diagnosing leaks, and basic pipe joining techniques.",
    why: "A foundational homeownership and self-reliance skill. Understanding how pressurized water enters and gravity-fed wastewater leaves a home demystifies residential infrastructure, ensures rapid and calm response to household leaks, and enables routine repairs and fixture updates without defaulting to emergency call-outs.",
    topics: ["Residential Plumbing", "Supply Lines & PEX/Copper", "DWV & P-Traps", "Fixture Maintenance", "Leak Diagnostics & Shutoffs", "Home Maintenance"],
  },
  {
    id: "residential-electrical-wiring",
    title: "Residential Electrical Systems & Small Wiring",
    phase: "future",
    status: "Target / Upcoming",
    period: "Future Horizon",
    provider: "Hands-On Practical Study & Electrical Safety Codes",
    category: "Home Systems & Maintenance",
    what: "Gaining a practical understanding of domestic electrical safety and circuit fundamentals: consumer units and circuit breakers, isolation and testing procedures (voltage testers, multimeters), residential wiring standards (live, neutral, ground/earth), and safely wiring or replacing small fixtures including light fixtures, light switches (1-way and 2-way), and power outlets.",
    why: "An essential homeownership and practical life skill. Knowing how home electrical distribution operates—and strictly adhering to isolation safety procedures—enables confident, safe troubleshooting and small-scale wiring upgrades while demystifying domestic electrical infrastructure.",
    topics: ["Domestic Electrical Safety", "Circuit Breakers & Consumer Units", "Lighting & Switch Wiring", "Socket Replacement", "Safe Voltage Isolation", "Home Maintenance"],
  },
  {
    id: "woodworking-foundations",
    title: "Foundations of Woodworking & Freestanding Furniture",
    phase: "future",
    status: "Target / Upcoming",
    period: "Future Horizon",
    provider: "Hands-On Workshop Practice & Progressive Builds",
    category: "Woodworking & Carpentry",
    what: "Developing foundational woodworking and joinery skills through progressive standalone builds: timber selection, grain reading, stock milling and squaring, edge and end-grain glue-ups, basic and traditional joinery (pocket screws, dowels, half-laps, and mortise & tenon), sanding grit sequences, and oil/wax finishing. Progression advances from small flat items (cutting boards, serving trays) to functional standalone furniture (stools, side tables, and occasional chairs).",
    why: "Starting with small, manageable builds develops essential tool safety, muscle memory, and a working respect for wood movement and tolerances. Building standalone pieces provides high-repetition, low-risk opportunities to master joinery and finish quality before tackling large-scale architectural projects.",
    topics: ["Woodworking Fundamentals", "Timber Milling & Squaring", "Joinery (Dowels / Mortise & Tenon)", "Glue-Ups & Clamping", "Standalone Furniture (Tables & Chairs)", "Finishing & Sanding"],
  },
  {
    id: "bespoke-built-in-cabinetry",
    title: "Custom Built-In Cabinetry & Architectural Joinery",
    phase: "future",
    status: "Target / Upcoming",
    period: "Future Horizon",
    provider: "Self-Directed Home Renovation & Joinery",
    category: "Woodworking & Carpentry",
    what: "Mastering the design, fabrication, and installation of fitted, bespoke furniture tailored to domestic spaces: breaking down sheet goods (hardwood plywood and MDF) with track saws, cabinet carcass construction (pocket hole, dado, and dowel joinery), face frames, precision scribing against out-of-square walls and uneven floors, and installing integrated hardware (concealed soft-close European cup hinges, undermount drawer runners, and adjustable shelving systems). Target projects include alcove cabinetry, fitted wardrobes, and custom media units.",
    why: "The culmination of practical woodworking for homeownership: crafting high-utility, custom-fitted furniture that maximizes living space and complements home architecture far better than mass-produced flat-pack furniture. Directly applies standalone furniture joinery to deliver high-durability, permanent home improvements.",
    topics: ["Bespoke Built-Ins", "Sheet Goods & Track Saws", "Carcass & Cabinet Construction", "Precision Scribing", "Concealed Hinges & Drawer Runners", "Architectural Fitting"],
  },

  // --- PAST MILESTONES ---
  {
    id: "google-ai-cert",
    title: "Google AI Professional Certificate",
    phase: "past",
    status: "Completed",
    period: "October 2026",
    provider: "Google (8-Course Professional Series on Coursera)",
    category: "AI & Agentic Systems",
    what: "Completed the comprehensive 8-course professional program covering end-to-end applied generative AI across modern software and product workflows: foundational AI principles, research synthesis (NotebookLM), data analysis with AI-generated queries and formulas, multimodal asset creation, rapid natural language software prototyping, AI-assisted code generation and debugging, and application deployment from sandbox to production.",
    why: "Mastering practical generative AI workflows—from rapid app prototyping and code assistance to deployment and data synthesis—bridges product discovery directly into functional software. Enables rapidly prototyping working MVPs, analyzing operational data, and evaluating technical feasibility in close collaboration with engineering pods.",
    topics: ["Prompt-Driven App Building", "AI-Assisted Prototyping", "Data Analysis & Query Generation", "Research Synthesis (NotebookLM)", "AI App Deployment", "Multimodal Generative Workflows"],
    link: {
      label: "View Coursera Certificate Program ↗",
      url: "https://www.coursera.org/professional-certificates/google-ai",
      external: true,
    },
  },
  {
    id: "google-cybersecurity",
    title: "Google Cybersecurity Professional Certificate",
    phase: "past",
    status: "Completed",
    period: "October 2026",
    provider: "Google (8-Course Specialization on Coursera)",
    category: "Security & Governance",
    what: "Completed the comprehensive 8-course professional specialization covering defensive security operations and risk management. Core syllabus includes the NIST Cybersecurity Framework (CSF) and CISSP security domains, threat modeling and vulnerability assessment (Nmap, Nessus), network architecture defense and packet inspection with Wireshark, hands-on Linux CLI administration and SQL log extraction, Security Operations Center (SOC) incident response playbooks, SIEM log monitoring (Chronicle, Splunk), and automated security scripting with Python.",
    why: "Directly complements earlier professional experience delivering 2FA authentication microservices and PSD2 SCA compliance for high-traffic banking applications. Grounding product requirements in NIST frameworks, threat modeling, and zero-trust principles ensures security and regulatory compliance are baked into system architectures from initial discovery rather than retrofitted post-launch.",
    topics: ["NIST CSF & Risk Management", "SIEM & SOC Incident Response", "Packet Inspection (Wireshark)", "Linux CLI & SQL Log Querying", "Threat Modeling & Vulnerability Scans", "Python Security Automation"],
    link: {
      label: "View Coursera Specialization ↗",
      url: "https://www.coursera.org/specializations/google-cybersecurity",
      external: true,
    },
  },
  {
    id: "google-ux-design",
    title: "Google UX Design Professional Certificate",
    phase: "past",
    status: "Completed",
    period: "July 2026",
    provider: "Google (7-Course Series on Coursera)",
    category: "Product & UX",
    what: "Completed the comprehensive 7-course professional curriculum covering the complete user experience design lifecycle: foundational user-centered design principles, conducting user research and empathy interviews, creating personas, empathy maps, and user journey maps, developing storyboards and information architecture, paper and digital wireframing in Figma, moderated and unmoderated usability studies with affinity diagrams, building design systems with reusable UI components and styles, responsive cross-device web design, WCAG accessibility compliance, and developer hand-off documentation.",
    why: "Eliminated hand-off friction between product management, UI/UX design, and engineering pods. Enables rapidly converting complex business requirements into tangible, interactive Figma prototypes, running empirical usability tests to de-risk feature bets, and maintaining a high standard of accessibility across enterprise digital products.",
    topics: ["Figma Component Systems", "Usability Testing & Studies", "Wireframing & Prototyping", "Information Architecture", "WCAG Accessibility", "Design Systems & Hand-off"],
    link: {
      label: "View Coursera Specialization ↗",
      url: "https://www.coursera.org/specializations/google-ux-design",
      external: true,
    },
  },
  {
    id: "pspo-1",
    title: "Professional Scrum Product Owner I (PSPO I)",
    phase: "past",
    status: "Completed",
    period: "June 2026",
    provider: "Scrum.org Industry Assessment",
    category: "Product & UX",
    what: "Earned the globally recognized Professional Scrum Product Owner I (PSPO I) certification validating mastery of Scrum framework mechanics and agile product management. Tested on the Scrum.org Professional Scrum Competencies: Understanding and Applying the Scrum Framework (empiricism, Scrum accountabilities, events, artifacts, and Definition of Done), Managing Products with Agility (product vision, outcome-driven value maximization, ordering and refining the Product Backlog), Forecasting and Release Planning, collaborating with self-managing cross-functional teams, and balancing stakeholder demands.",
    why: "Codified the discipline of empirical product ownership. Ensures product roadmaps are driven by measurable customer and business value rather than feature factory output metrics, enabling effective collaboration with software developers on 'what' to build while empowering engineering autonomy on 'how' to build it.",
    topics: ["Product Value Maximization", "Empirical Process Control", "Product Backlog Management", "Release Forecasting", "Sprint Goal Alignment", "Stakeholder Collaboration"],
    link: {
      label: "View Scrum.org Certification Assessment ↗",
      url: "https://www.scrum.org/assessments/professional-scrum-product-owner-i-certification",
      external: true,
    },
  },
  {
    id: "google-prompting-essentials",
    title: "Google Prompting Essentials Specialization",
    phase: "past",
    status: "Completed",
    period: "January 2026",
    provider: "Google (4-Course Series on Coursera)",
    category: "AI & Agentic Systems",
    what: "Completed the hands-on 4-course specialization mastering Google's structured 5-step prompt framework (Task, Context, References, Evaluate, Iterate). Key areas covered include multimodal prompting (combining text, image, and tabular inputs), advanced prompt chaining across multi-step analytical workflows, designing prompts for data analysis and slide structuring, AI roleplaying for collaborative problem-solving, and building a reusable personal prompt library.",
    why: "Elevated prompting from ad-hoc chatting into an empirical, structured engineering framework. Mastering prompt chaining, multi-step logic decomposition, and systematic context framing dramatically accelerates drafting PRDs, synthesizing complex stakeholder feedback, and designing predictable LLM feature prototypes.",
    topics: ["5-Step Prompt Framework", "Prompt Chaining & Multi-Step Logic", "Multimodal Prompting", "Context & Persona Framing", "Reusable Prompt Libraries", "Output Evaluation & Iteration"],
    link: {
      label: "View Coursera Specialization ↗",
      url: "https://www.coursera.org/specializations/prompting-essentials-google",
      external: true,
    },
  },
  {
    id: "google-ai-essentials",
    title: "Google AI Essentials Specialization",
    phase: "past",
    status: "Completed",
    period: "January 2026",
    provider: "Google (5-Course Series on Coursera)",
    category: "AI & Agentic Systems",
    what: "Completed the foundational 5-course specialization exploring how artificial intelligence and machine learning function beneath the surface. Focuses on integrating generative AI tools (Google Gemini) into workplace workflows to automate tasks and summarize long-form documents, understanding core model mechanics and capabilities/limitations, and practicing responsible AI through bias detection, privacy protection, and hallucination fact-checking.",
    why: "Established the conceptual and operational baseline for evaluating generative AI systems. Provided a clear understanding of probabilistic model boundaries and human-in-the-loop validation, setting the foundation for responsible AI adoption in production product ecosystems.",
    topics: ["Workplace AI Integration", "Document Summarization", "Responsible AI & Bias Mitigation", "Hallucination Fact-Checking", "AI Productivity Automation", "Machine Learning Fundamentals"],
    link: {
      label: "View Coursera Specialization ↗",
      url: "https://www.coursera.org/specializations/ai-essentials-google",
      external: true,
    },
  },
  {
    id: "bsc-degrees",
    title: "BSc (Hons) Computer Science & Computer Systems Engineering",
    phase: "past",
    status: "Completed",
    period: "2013 – 2017",
    provider: "Kingston University & University of Kent",
    category: "Computer Science",
    what: "Full academic degree foundation in computer science and systems engineering. Core curriculum: Data Structures & Algorithms (Big-O analysis), operating systems internals, memory management, computer architecture, network protocols, relational database design (3NF), and software engineering principles.",
    why: "Formed the foundational bedrock of technical literacy, enabling deep systems thinking, code reading fluency across multiple languages, and empathetic, high-credibility partnerships with senior engineering teams.",
    topics: ["Algorithms & Data Structures", "Computer Architecture", "Operating Systems", "Relational Databases", "Networking Fundamentals"],
    link: {
      label: "Verified on Resume ↗",
      url: `${base}/resume`,
    },
  },
];

const counts = {
  all: learningItems.length,
  current: learningItems.filter((i) => i.phase === 'current').length,
  future: learningItems.filter((i) => i.phase === 'future').length,
  past: learningItems.filter((i) => i.phase === 'past').length,
};

const categories = Array.from(new Set(learningItems.map((i) => i.category)));
---

<BaseLayout
  title="Learning Objectives & Timeline"
  description="Personal learning roadmap, technical objectives, and continuous growth timeline spanning past milestones, active pursuits, and future horizons."
>
  <div class="space-y-12">
    <!-- Header / Mission Hero -->
    <header class="space-y-4">
      <h1 class="type-h1 sm:text-5xl">
        Learning Objectives <span class="text-blue-500">&amp;</span> Timeline
      </h1>

      <p class="type-lead max-w-3xl">
        Operating at the intersection of product engineering and technical product management, I believe high-leverage software building is rooted in deep systems intuition and broad creative curiosity. This live log tracks my learning roadmap across <span class="text-zinc-900 dark:text-zinc-100 font-medium">networking</span>, <span class="text-zinc-900 dark:text-zinc-100 font-medium">agentic AI systems</span>, <span class="text-zinc-900 dark:text-zinc-100 font-medium">security</span>, <span class="text-zinc-900 dark:text-zinc-100 font-medium">product leadership</span>, <span class="text-zinc-900 dark:text-zinc-100 font-medium">game development</span>, <span class="text-zinc-900 dark:text-zinc-100 font-medium">creative writing</span>, <span class="text-zinc-900 dark:text-zinc-100 font-medium">languages</span>, and <span class="text-zinc-900 dark:text-zinc-100 font-medium">practical craft &amp; mechanical systems</span>—articulating what I learn, the motivation behind it, and the timeline of each milestone.
      </p>
    </header>

    <!-- Controls Bar: Phase Filters & Category Dropdown -->
    <section class="sticky top-16 z-30 py-3 bg-zinc-50/90 dark:bg-zinc-950/90 backdrop-blur-md border-y border-default flex flex-wrap items-center justify-between gap-3">
      <!-- Phase Filter Toggle Group (WCAG 1.3.1 / 4.1.2) -->
      <div id="phase-filters" class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter timeline by phase">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="filter-tab active px-3 py-1.5 rounded-lg text-xs font-semibold cursor-pointer transition-all bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 shadow-xs"
        >
          All ({counts.all})
        </button>
        <button
          type="button"
          data-filter="current"
          aria-pressed="false"
          class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold cursor-pointer transition-all bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border border-default hover:border-amber-400 dark:hover:border-amber-500"
        >
          <span class="inline-block w-2 h-2 rounded-full bg-amber-500 mr-1.5 animate-pulse" aria-hidden="true"></span>
          Current ({counts.current})
        </button>
        {counts.future > 0 && (
          <button
            type="button"
            data-filter="future"
            aria-pressed="false"
            class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold cursor-pointer transition-all bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border border-default hover:border-indigo-400 dark:hover:border-indigo-500"
          >
            <span class="inline-block w-2 h-2 rounded-full bg-indigo-500 mr-1.5" aria-hidden="true"></span>
            Future ({counts.future})
          </button>
        )}
        <button
          type="button"
          data-filter="past"
          aria-pressed="false"
          class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold cursor-pointer transition-all bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border border-default hover:border-emerald-400 dark:hover:border-emerald-500"
        >
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 mr-1.5" aria-hidden="true"></span>
          Past ({counts.past})
        </button>
      </div>

      <!-- Category Filter Select -->
      <div class="flex items-center gap-2">
        <label for="category-select" class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Domain:</label>
        <select
          id="category-select"
          class="form-select"
        >
          <option value="all">All Domains</option>
          {categories.map((cat) => (
            <option value={cat}>{cat}</option>
          ))}
        </select>
      </div>
    </section>

    <!-- Visual Timeline Container -->
    <section class="relative pt-4" aria-label="Learning Timeline">
      <div id="timeline-list" class="relative space-y-10 sm:space-y-12">
        <!-- Continuous Vertical Timeline Spine (Rail) -->
        <div
          class="absolute left-4 sm:left-5 -translate-x-1/2 top-4 bottom-6 w-0.5 bg-gradient-to-b from-amber-400 via-indigo-400 to-zinc-300 dark:to-zinc-800 pointer-events-none"
          aria-hidden="true"
        ></div>

        {learningItems.map((item) => {
          const isCurrent = item.phase === 'current';
          const isFuture = item.phase === 'future';
          const isPast = item.phase === 'past';

          const phaseTheme = isCurrent
            ? {
                badgeBg: 'bg-amber-100 text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 border-amber-300 dark:border-amber-800',
                nodeBg: 'bg-amber-500 ring-4 ring-amber-100 dark:ring-amber-950/60',
                borderAccent: 'border-l-4 border-l-amber-500',
                phaseLabel: 'Current Focus',
              }
            : isFuture
            ? {
                badgeBg: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950/80 dark:text-indigo-300 border-indigo-300 dark:border-indigo-800',
                nodeBg: 'bg-indigo-500 ring-4 ring-indigo-100 dark:ring-indigo-950/60',
                borderAccent: 'border-l-4 border-l-indigo-500',
                phaseLabel: 'Target Horizon',
              }
            : {
                badgeBg: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800',
                nodeBg: 'bg-emerald-500 ring-4 ring-emerald-100 dark:ring-emerald-950/60',
                borderAccent: 'border-l-4 border-l-emerald-500',
                phaseLabel: 'Completed Milestone',
              };

          return (
            <article
              id={item.id}
              data-phase={item.phase}
              data-category={item.category}
              class="timeline-card relative flex items-start gap-3 sm:gap-6 transition-all duration-300"
            >
              <!-- Timeline Node Marker in Center-Aligned Rail -->
              <div class="relative flex justify-center shrink-0 w-8 sm:w-10 pt-6">
                <div
                  class={`relative z-10 w-5 h-5 rounded-full ${phaseTheme.nodeBg} flex items-center justify-center text-white shadow-xs`}
                  aria-hidden="true"
                >
                  {isCurrent && (
                    <span class="absolute -inset-1 rounded-full bg-amber-400/40 animate-ping pointer-events-none"></span>
                  )}
                  {isPast ? (
                    <Icon name="check" class="w-3 h-3 text-white" />
                  ) : isCurrent ? (
                    <span class="w-2 h-2 rounded-full bg-white"></span>
                  ) : (
                    <Icon name="plus" class="w-3 h-3 text-white" />
                  )}
                </div>
              </div>

              <!-- Main Card Container -->
              <div class={`card-interactive flex-1 min-w-0 p-5 sm:p-7 ${phaseTheme.borderAccent}`}>
                <!-- Meta Row: Period, Status, Category -->
                <div class="flex flex-wrap items-center justify-between gap-2.5 pb-3 border-b border-subtle text-xs">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-mono font-semibold text-zinc-900 dark:text-zinc-100 flex items-center gap-1.5">
                      <Icon name="calendar" class="w-3.5 h-3.5 text-zinc-400" />
                      {item.period}
                    </span>
                    <span class="text-zinc-300 dark:text-zinc-700">•</span>
                    <span class="text-zinc-500 dark:text-zinc-400 font-medium">
                      {item.provider}
                    </span>
                  </div>

                  <div class="flex items-center gap-2">
                    <span class="category-pill">
                      {item.category}
                    </span>
                    <span class={`text-xs px-2.5 py-0.5 rounded-full font-medium border ${phaseTheme.badgeBg}`}>
                      {item.status}
                    </span>
                  </div>
                </div>

                <!-- Title & Header -->
                <div class="pt-4 pb-2">
                  <h2 class="type-h2">
                    {item.title}
                  </h2>
                </div>

                <!-- Content Block 1: "The What" -->
                <div class="space-y-1.5 mt-3">
                  <div class="flex items-center gap-1.5 type-eyebrow">
                    <Icon name="computer-desktop" class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" />
                    <span>{item.category === 'Creative Writing' ? 'The Creative Objective (What)' : item.category === 'Language Learning' ? 'The Language Objective (What)' : item.category === 'Automotive & Mechanical' || item.category === 'Home Systems & Maintenance' || item.category === 'Woodworking & Carpentry' ? 'The Practical Objective (What)' : 'The Technical Objective (What)'}</span>
                  </div>
                  <p class="text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
                    {item.what}
                  </p>
                </div>

                <!-- Content Block 2: "The Why" (Rationale & Strategic Product Impact / Personal Motivation) -->
                <div class="card-muted p-4 mt-4 space-y-1.5">
                  <div class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">
                    <Icon name="bolt" class="w-3.5 h-3.5 text-amber-500" />
                    <span>{item.category === 'Creative Writing' ? 'Personal Motivation & Creative Growth (Why)' : item.category === 'Language Learning' ? 'Personal Motivation & Heritage Connection (Why)' : item.category === 'Automotive & Mechanical' ? 'Practical Value & Systems Foundation (Why)' : item.category === 'Home Systems & Maintenance' || item.category === 'Woodworking & Carpentry' ? 'Practical Value & Self-Reliance (Why)' : item.category === 'Game Development' ? 'Creative Curiosity & Systems Exploration (Why)' : 'Strategic Motivation & Builder Impact (Why)'}</span>
                  </div>
                  <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed italic">
                    "{item.why}"
                  </p>
                </div>

                <!-- Key Topics Tag Pills -->
                <div class="mt-5 pt-4 border-t border-subtle flex flex-wrap items-center justify-between gap-3">
                  <div class="flex flex-wrap items-center gap-1.5">
                    {item.topics.map((topic) => (
                      <span class="tag-pill">
                        {topic}
                      </span>
                    ))}
                  </div>

                  {item.link && (
                    <a
                      href={item.link.url}
                      target={item.link.external ? "_blank" : undefined}
                      rel={item.link.external ? "noopener noreferrer" : undefined}
                      class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline shrink-0"
                    >
                      <span>{item.link.label}</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- No items found state (dynamically shown if filters match nothing) -->
      <div id="no-results" role="status" aria-live="polite" class="hidden text-center py-16 px-4 space-y-3">
        <p class="text-zinc-600 dark:text-zinc-400 text-sm">
          No learning objectives match the selected filter combination.
        </p>
        <button
          id="reset-filters-btn"
          type="button"
          class="btn-primary"
        >
          Reset Filters
        </button>
      </div>
    </section>

    <!-- Bottom Learning Philosophy Footer -->
    <section class="card-base p-6 sm:p-8 mt-16 text-center space-y-3">
      <h3 class="type-h3">
        Lifelong Learning as a Product Discipline
      </h3>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        Technical breadth combined with vertical depth creates resilient software leaders. Whether debugging packet drops in a home lab or shaping enterprise roadmaps, staying hands-on keeps product strategy grounded in engineering reality.
      </p>
      <div class="pt-2 flex flex-wrap justify-center gap-3">
        <a
          href={`${base}/resume`}
          class="btn-secondary"
        >
          View Full Resume &amp; Experience →
        </a>
        <a
          href={`${base}/projects`}
          class="btn-primary"
        >
          Explore Built Projects →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const tabButtons = document.querySelectorAll('.filter-tab');
    const categorySelect = document.getElementById('category-select');
    const cards = document.querySelectorAll('.timeline-card');
    const noResults = document.getElementById('no-results');
    const resetBtn = document.getElementById('reset-filters-btn');

    let currentPhase = 'all';
    let currentCategory = 'all';

    function applyFilters() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardPhase = card.getAttribute('data-phase');
        const cardCat = card.getAttribute('data-category');

        const phaseMatch = currentPhase === 'all' || cardPhase === currentPhase;
        const categoryMatch = currentCategory === 'all' || cardCat === currentCategory;

        if (phaseMatch && categoryMatch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    tabButtons.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabButtons.forEach((btn) => {
          btn.classList.remove('active', 'bg-zinc-900', 'text-white', 'dark:bg-zinc-100', 'dark:text-zinc-900');
          btn.classList.add('bg-white', 'dark:bg-zinc-900', 'text-zinc-700', 'dark:text-zinc-300');
          btn.setAttribute('aria-pressed', 'false');
        });

        tab.classList.add('active', 'bg-zinc-900', 'text-white', 'dark:bg-zinc-100', 'dark:text-zinc-900');
        tab.classList.remove('bg-white', 'dark:bg-zinc-900', 'text-zinc-700', 'dark:text-zinc-300');
        tab.setAttribute('aria-pressed', 'true');

        currentPhase = tab.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    if (categorySelect) {
      categorySelect.addEventListener('change', (e) => {
        currentCategory = e.target.value;
        applyFilters();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        currentPhase = 'all';
        currentCategory = 'all';
        if (categorySelect) categorySelect.value = 'all';

        tabButtons.forEach((btn, idx) => {
          if (idx === 0) {
            btn.classList.add('active', 'bg-zinc-900', 'text-white', 'dark:bg-zinc-100', 'dark:text-zinc-900');
            btn.classList.remove('bg-white', 'dark:bg-zinc-900', 'text-zinc-700', 'dark:text-zinc-300');
            btn.setAttribute('aria-pressed', 'true');
          } else {
            btn.classList.remove('active', 'bg-zinc-900', 'text-white', 'dark:bg-zinc-100', 'dark:text-zinc-900');
            btn.classList.add('bg-white', 'dark:bg-zinc-900', 'text-zinc-700', 'dark:text-zinc-300');
            btn.setAttribute('aria-pressed', 'false');
          }
        });

        applyFilters();
      });
    }
  })();
</script>
