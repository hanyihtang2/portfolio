---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Page Not Found"
  description="The requested page could not be found."
  mainClass="max-w-2xl w-full mx-auto px-6 py-16 sm:py-24 flex-1 flex flex-col items-center justify-center text-center"
>
  <div class="space-y-6 w-full">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/60 shadow-xs">
      <span class="text-2xl font-mono font-bold">404</span>
    </div>

    <div class="space-y-2">
      <h1 class="type-h1">Page Not Found</h1>
      <p class="type-lead max-w-md mx-auto">
        Sorry, the page you're looking for doesn't exist, has been moved, or is temporarily unavailable.
      </p>
    </div>

    <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
      <a href={`${base}/`} class="btn-primary">
        Return Home
      </a>
      <a href={`${base}/projects`} class="btn-secondary">
        All Projects &amp; Concepts
      </a>
      <a href={`${base}/resume`} class="btn-secondary">
        View Resume
      </a>
    </div>

    <!-- Quick Help Links -->
    <div class="pt-8 border-t border-default max-w-md mx-auto w-full grid grid-cols-1 sm:grid-cols-2 gap-3 text-left">
      <a
        href={`${base}/learning`}
        class="card-interactive p-4 rounded-xl flex flex-col justify-between"
      >
        <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">Learning Roadmap</span>
        <span class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-1">Objectives &amp; progress &rarr;</span>
      </a>
      <a
        href={`${base}/contact`}
        class="card-interactive p-4 rounded-xl flex flex-col justify-between"
      >
        <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">Get in Touch</span>
        <span class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-1">Direct contact channels &rarr;</span>
      </a>
    </div>
  </div>
</BaseLayout>

