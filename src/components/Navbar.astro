---
import Icon from './Icon.astro';

const pathname = new URL(Astro.request.url).pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = pathname.replace(/\/$/, "");

const navItems = [
  { name: "Home", href: `${base}/` },
  { name: "Projects", href: `${base}/projects` },
  { name: "Learning", href: `${base}/learning` },
  { name: "Contact", href: `${base}/contact` },
];
---

<header class="sticky top-0 z-50 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md border-b border-default">
  <nav class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between" aria-label="Main Navigation">
    <!-- Brand Logo -->
    <a
      href={`${base}/`}
      aria-label="Han-Yih Tang — Home"
      class="group inline-flex items-center justify-center w-9 h-9 rounded-lg bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 shadow-xs ring-1 ring-zinc-900/10 dark:ring-white/20 hover:bg-blue-600 dark:hover:bg-blue-500 dark:hover:text-white transition-colors"
    >
      <Icon name="logo" class="w-5 h-5" />
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-6 text-sm font-medium">
      {navItems.map((item) => {
        const isActive = currentPath === item.href.replace(/\/$/, "");
        return (
          <a
            href={item.href}
            class={`transition-colors hover:text-blue-500 ${
              isActive 
                ? "text-blue-600 dark:text-blue-400 font-semibold" 
                : "text-zinc-600 dark:text-zinc-400"
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </div>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-3">
      <!-- Theme Toggle (visible on both mobile and desktop) -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        title="Toggle light/dark theme"
        class="btn-ghost p-2"
      >
        <!-- Sun icon (shown in dark mode) -->
        <Icon name="sun" class="w-4 h-4 hidden dark:block" />
        <!-- Moon icon (shown in light mode) -->
        <Icon name="moon" class="w-4 h-4 block dark:hidden" />
      </button>

      <!-- Desktop-only items: GitHub & Resume button -->
      <a
        href="https://github.com/hanyihtang2"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        title="GitHub Profile"
        class="btn-ghost hidden md:inline-flex p-2"
      >
        <Icon name="github" class="w-4 h-4 fill-current" />
      </a>
      <a
        href={`${base}/resume`}
        class="btn-primary hidden md:inline-flex py-1.5 px-3.5"
      >
        Resume
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="btn-ghost md:hidden p-2"
      >
        <!-- Hamburger Icon (bars) -->
        <Icon id="menu-icon-open" name="menu" class="w-4 h-4 block" />
        <!-- Close Icon (X) -->
        <Icon id="menu-icon-close" name="x" class="w-4 h-4 hidden" />
      </button>
    </div>
  </nav>

  <!-- Mobile Collapsible Menu Sheet -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-default bg-white/95 dark:bg-zinc-950/95 backdrop-blur-md px-6 py-4 flex-col gap-2"
  >
    {navItems.map((item) => {
      const isActive = currentPath === item.href.replace(/\/$/, "");
      return (
        <a
          href={item.href}
          class={`px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
            isActive
              ? "text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 font-semibold"
              : "text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-900"
          }`}
        >
          {item.name}
        </a>
      );
    })}

    <!-- Mobile Secondary Actions: GitHub & Resume -->
    <div class="pt-3 mt-1 border-t border-default flex items-center gap-3">
      <a
        href="https://github.com/hanyihtang2"
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 inline-flex items-center justify-center gap-2 py-2 px-3 text-xs font-medium rounded-lg border border-default text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
      >
        <Icon name="github" class="w-4 h-4 fill-current" />
        GitHub
      </a>
      <a
        href={`${base}/resume`}
        class="flex-1 inline-flex items-center justify-center py-2 px-3 text-xs font-semibold rounded-lg bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 hover:opacity-90 transition-opacity"
      >
        Resume
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    // Theme toggle
    const toggleBtn = document.getElementById('theme-toggle');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (e) {}
      });
    }

    // Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (menuBtn && mobileMenu && iconOpen && iconClose) {
      const toggleMenu = (isOpen) => {
        const open = isOpen ?? mobileMenu.classList.contains('hidden');
        if (open) {
          mobileMenu.classList.remove('hidden');
          mobileMenu.classList.add('flex');
          iconOpen.classList.add('hidden');
          iconOpen.classList.remove('block');
          iconClose.classList.remove('hidden');
          iconClose.classList.add('block');
          menuBtn.setAttribute('aria-expanded', 'true');
        } else {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('flex');
          iconOpen.classList.remove('hidden');
          iconOpen.classList.add('block');
          iconClose.classList.add('hidden');
          iconClose.classList.remove('block');
          menuBtn.setAttribute('aria-expanded', 'false');
        }
      };

      menuBtn.addEventListener('click', () => toggleMenu());

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
          toggleMenu(false);
          menuBtn.focus();
        }
      });

      // Close when clicking any link inside mobile menu
      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => toggleMenu(false));
      });

      // Close on window resize if scaled past md breakpoint
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768 && !mobileMenu.classList.contains('hidden')) {
          toggleMenu(false);
        }
      });
    }
  })();
</script>
