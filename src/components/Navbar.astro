---
const pathname = new URL(Astro.request.url).pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = pathname.replace(/\/$/, "");

const navItems = [
  { name: "Home", href: `${base}/` },
  { name: "Projects", href: `${base}/projects` },
  { name: "About", href: `${base}/about` },
  { name: "Contact", href: `${base}/contact` },
];
---

<header class="sticky top-0 z-50 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md border-b border-zinc-200 dark:border-zinc-800">
  <nav class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href={`${base}/`} class="font-bold text-lg text-zinc-900 dark:text-zinc-100 tracking-tight">
      Developer<span class="text-blue-500">.</span>
    </a>

    <div class="flex items-center gap-6 text-sm font-medium">
      {navItems.map((item) => {
        const isActive = currentPath === item.href.replace(/\/$/, "");
        return (
          <a
            href={item.href}
            class={`transition-colors hover:text-blue-500 ${
              isActive 
                ? "text-blue-600 dark:text-blue-400 font-semibold" 
                : "text-zinc-600 dark:text-zinc-400"
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </div>

    <div class="flex items-center gap-4">
      <a
        href="https://github.com/hanyihtang2"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
      <a
        href="#"
        class="hidden sm:inline-block px-3.5 py-1.5 text-xs font-semibold rounded-md bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 hover:opacity-90 transition-opacity"
      >
        Resume
      </a>
    </div>
  </nav>
</header>