---
const pathname = new URL(Astro.request.url).pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = pathname.replace(/\/$/, "");

const navItems = [
  { name: "Home", href: `${base}/` },
  { name: "Projects", href: `${base}/projects` },
  { name: "Learning", href: `${base}/learning` },
  { name: "Contact", href: `${base}/contact` },
];
---

<header class="sticky top-0 z-50 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md border-b border-default">
  <nav class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between" aria-label="Main Navigation">
    <!-- Brand Logo -->
    <a
      href={`${base}/`}
      aria-label="Han-Yih Tang — Home"
      class="group inline-flex items-center justify-center w-9 h-9 rounded-lg bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 shadow-xs ring-1 ring-zinc-900/10 dark:ring-white/20 hover:bg-blue-600 dark:hover:bg-blue-500 dark:hover:text-white transition-colors"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Geometric 'H' -->
        <path d="M4.5 6V18M4.5 12H10.5M10.5 6V18" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
        <!-- Geometric 'T' -->
        <path d="M13.5 6H20.5M17 6V18" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-6 text-sm font-medium">
      {navItems.map((item) => {
        const isActive = currentPath === item.href.replace(/\/$/, "");
        return (
          <a
            href={item.href}
            class={`transition-colors hover:text-blue-500 ${
              isActive 
                ? "text-blue-600 dark:text-blue-400 font-semibold" 
                : "text-zinc-600 dark:text-zinc-400"
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </div>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-3">
      <!-- Theme Toggle (visible on both mobile and desktop) -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        title="Toggle light/dark theme"
        class="btn-ghost p-2"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Desktop-only items: GitHub & Resume button -->
      <a
        href="https://github.com/hanyihtang2"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="hidden md:inline-flex text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
      <a
        href={`${base}/resume`}
        class="btn-primary hidden md:inline-flex py-1.5 px-3.5"
      >
        Resume
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="btn-ghost md:hidden p-2"
      >
        <!-- Hamburger Icon (bars) -->
        <svg id="menu-icon-open" class="w-4 h-4 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close Icon (X) -->
        <svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Collapsible Menu Sheet -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-default bg-white/95 dark:bg-zinc-950/95 backdrop-blur-md px-6 py-4 flex-col gap-2"
  >
    {navItems.map((item) => {
      const isActive = currentPath === item.href.replace(/\/$/, "");
      return (
        <a
          href={item.href}
          class={`px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
            isActive
              ? "text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/40 font-semibold"
              : "text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-900"
          }`}
        >
          {item.name}
        </a>
      );
    })}

    <!-- Mobile Secondary Actions: GitHub & Resume -->
    <div class="pt-3 mt-1 border-t border-default flex items-center gap-3">
      <a
        href="https://github.com/hanyihtang2"
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 inline-flex items-center justify-center gap-2 py-2 px-3 text-xs font-medium rounded-lg border border-default text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        GitHub
      </a>
      <a
        href={`${base}/resume`}
        class="flex-1 inline-flex items-center justify-center py-2 px-3 text-xs font-semibold rounded-lg bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 hover:opacity-90 transition-opacity"
      >
        Resume
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    // Theme toggle
    const toggleBtn = document.getElementById('theme-toggle');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (e) {}
      });
    }

    // Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (menuBtn && mobileMenu && iconOpen && iconClose) {
      const toggleMenu = (isOpen) => {
        const open = isOpen ?? mobileMenu.classList.contains('hidden');
        if (open) {
          mobileMenu.classList.remove('hidden');
          mobileMenu.classList.add('flex');
          iconOpen.classList.add('hidden');
          iconOpen.classList.remove('block');
          iconClose.classList.remove('hidden');
          iconClose.classList.add('block');
          menuBtn.setAttribute('aria-expanded', 'true');
        } else {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('flex');
          iconOpen.classList.remove('hidden');
          iconOpen.classList.add('block');
          iconClose.classList.add('hidden');
          iconClose.classList.remove('block');
          menuBtn.setAttribute('aria-expanded', 'false');
        }
      };

      menuBtn.addEventListener('click', () => toggleMenu());

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
          toggleMenu(false);
          menuBtn.focus();
        }
      });

      // Close when clicking any link inside mobile menu
      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => toggleMenu(false));
      });

      // Close on window resize if scaled past md breakpoint
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768 && !mobileMenu.classList.contains('hidden')) {
          toggleMenu(false);
        }
      });
    }
  })();
</script>
