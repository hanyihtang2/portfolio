---
export type ProjectStatus = 'Completed' | 'In Progress' | 'Planned' | 'Concept' | string;

export interface StatusConfig {
  badge: string;
  dot: string;
}

export const statusTheme: Record<string, StatusConfig> = {
  'Completed': {
    badge: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border-emerald-300/60 dark:border-emerald-800/60',
    dot: 'bg-emerald-500',
  },
  'In Progress': {
    badge: 'bg-amber-100 text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 border-amber-300/60 dark:border-amber-800/60',
    dot: 'bg-amber-500',
  },
  'Planned': {
    badge: 'bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400 border-zinc-200 dark:border-zinc-700',
    dot: 'bg-zinc-400',
  },
  'Concept': {
    badge: 'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700',
    dot: 'bg-zinc-400',
  },
};

const defaultTheme: StatusConfig = {
  badge: 'bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400 border-zinc-200 dark:border-zinc-700',
  dot: 'bg-zinc-400',
};

interface Props {
  status: ProjectStatus;
  size?: 'sm' | 'md';
  showDot?: boolean;
  showIcon?: boolean;
  class?: string;
}

const {
  status,
  size = 'md',
  showDot = false,
  showIcon = false,
  class: className = '',
} = Astro.props;

const config = statusTheme[status] || defaultTheme;
const isCompleted = status === 'Completed';
const isInProgress = status === 'In Progress';
const isPlanned = status === 'Planned';

const sizeClasses = {
  sm: 'text-xs px-2 py-0.5 font-medium',
  md: 'text-xs px-2.5 py-1 font-semibold',
};
---

<span
  class={`inline-flex items-center gap-1.5 shrink-0 rounded-full border transition-colors ${sizeClasses[size]} ${config.badge} ${className}`}
>
  {showDot && (
    <span
      class={`w-1.5 h-1.5 rounded-full ${config.dot} ${isInProgress ? 'animate-pulse' : ''}`}
      aria-hidden="true"
    />
  )}

  {showIcon && isCompleted && (
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
    </svg>
  )}

  {showIcon && isInProgress && (
    <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse" aria-hidden="true" />
  )}

  {showIcon && isPlanned && (
    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
    </svg>
  )}

  <span>{status}</span>
</span>

