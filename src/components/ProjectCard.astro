---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const HeadingTag = headingLevel;
---

<article class="group relative p-6 border border-zinc-200 dark:border-zinc-800 rounded-lg bg-white dark:bg-zinc-900 flex flex-col justify-between hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
  <div>
    <div class="flex justify-between items-start gap-4 mb-2">
      <HeadingTag class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        <a
          href={`${base}/projects/${project.id}`}
          class="after:absolute after:inset-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded"
        >
          {project.data.title}
        </a>
      </HeadingTag>
      <span
        class={`shrink-0 text-xs px-2 py-0.5 rounded font-medium ${
          project.data.status === 'Completed'
            ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300'
            : project.data.status === 'In Progress'
            ? 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300'
            : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400'
        }`}
      >
        {project.data.status}
      </span>
    </div>
    <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-4">{project.data.description}</p>
    <div class="flex flex-wrap gap-2 mb-6">
      {project.data.tags.map(tag => (
        <span class="text-xs font-mono bg-zinc-100 dark:bg-zinc-800 px-2 py-1 rounded text-zinc-600 dark:text-zinc-300">
          {tag}
        </span>
      ))}
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-medium border-t border-zinc-100 dark:border-zinc-800 pt-4">
    <a
      href={`${base}/projects/${project.id}`}
      tabindex="-1"
      aria-hidden="true"
      class="relative z-10 py-1 text-blue-600 dark:text-blue-400 group-hover:underline flex items-center gap-1"
    >
      Read Case Study &rarr;
    </a>
    <a
      href={`${base}/projects/${project.id}/roadmap`}
      class="relative z-10 py-1 text-zinc-600 dark:text-zinc-400 hover:text-blue-600 dark:hover:text-blue-400 hover:underline"
      aria-label={`View roadmap for ${project.data.title}`}
    >
      Roadmap ↗
    </a>
    {project.data.githubUrl && (
      <a
        href={project.data.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="relative z-10 py-1 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:underline"
        aria-label={`GitHub repository for ${project.data.title}`}
      >
        GitHub ↗
      </a>
    )}
    {project.data.liveUrl && (
      <a
        href={project.data.liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="relative z-10 py-1 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:underline"
        aria-label={`Live demo for ${project.data.title}`}
      >
        Live Demo ↗
      </a>
    )}
  </div>
</article>

