---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const HeadingTag = headingLevel;
---

<article
  class="project-card card-interactive group relative p-6 flex flex-col justify-between transition-all duration-200"
  data-status={project.data.status}
>
  <div>
    <div class="flex justify-between items-start gap-4 mb-2">
      <HeadingTag class="text-xl font-bold tracking-tight text-primary group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        <a
          href={`${base}/projects/${project.id}`}
          class="after:absolute after:inset-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded"
        >
          {project.data.title}
        </a>
      </HeadingTag>
      <StatusBadge status={project.data.status} size="sm" />
    </div>
    <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-4 line-clamp-3" title={project.data.description}>
      {project.data.description}
    </p>
    <div class="flex flex-wrap gap-2 mb-6">
      {project.data.tags.map(tag => (
        <span class="tag-pill">{tag}</span>
      ))}
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-medium border-t border-subtle pt-4">
    <a
      href={`${base}/projects/${project.id}`}
      tabindex="-1"
      aria-hidden="true"
      class="relative z-10 py-1 text-blue-600 dark:text-blue-400 group-hover:underline flex items-center gap-1"
    >
      Read Case Study &rarr;
    </a>
    <a
      href={`${base}/projects/${project.id}/roadmap`}
      class="relative z-10 py-1 text-zinc-600 dark:text-zinc-400 hover:text-blue-600 dark:hover:text-blue-400 hover:underline"
      aria-label={`View roadmap for ${project.data.title}`}
    >
      Roadmap &rarr;
    </a>
    {project.data.githubUrl && (
      <a
        href={project.data.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="outbound_github_click"
        data-analytics-project={project.id}
        data-analytics-url={project.data.githubUrl}
        class="relative z-10 py-1 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:underline"
        aria-label={`GitHub repository for ${project.data.title}`}
      >
        GitHub ↗
      </a>
    )}
    {project.data.liveUrl && (
      <a
        href={project.data.liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="outbound_demo_click"
        data-analytics-project={project.id}
        data-analytics-url={project.data.liveUrl}
        class="relative z-10 py-1 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:underline"
        aria-label={`Live demo for ${project.data.title}`}
      >
        Live Demo ↗
      </a>
    )}
  </div>
</article>

