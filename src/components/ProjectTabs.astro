---
import Icon from './Icon.astro';

interface Props {
  slug: string;
  activeTab: 'overview' | 'roadmap';
}

const { slug, activeTab } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="border-b border-default mt-6 mb-8">
  <nav class="flex items-center gap-6 text-sm font-medium -mb-px" aria-label="Project Section Navigation">
    <a
      href={`${base}/projects/${slug}`}
      class={`pb-3 border-b-2 transition-colors inline-flex items-center gap-2 ${
        activeTab === 'overview'
          ? 'border-blue-600 text-blue-600 dark:text-blue-400 font-semibold'
          : 'border-transparent text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200'
      }`}
      aria-current={activeTab === 'overview' ? 'page' : undefined}
    >
      <Icon name="document-text" class="w-4 h-4" />
      <span>Case Study Overview</span>
    </a>

    <a
      href={`${base}/projects/${slug}/roadmap`}
      class={`pb-3 border-b-2 transition-colors inline-flex items-center gap-2 ${
        activeTab === 'roadmap'
          ? 'border-blue-600 text-blue-600 dark:text-blue-400 font-semibold'
          : 'border-transparent text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200'
      }`}
      aria-current={activeTab === 'roadmap' ? 'page' : undefined}
    >
      <Icon name="chart-bar" class="w-4 h-4" />
      <span>Product Roadmap</span>
    </a>
  </nav>
</div>

