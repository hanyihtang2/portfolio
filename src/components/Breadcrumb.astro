---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`mb-6 ${className}`}>
  <ol class="flex flex-wrap items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="inline-flex items-center gap-2">
          {index > 0 && (
            <span class="text-zinc-400 dark:text-zinc-600 select-none" aria-hidden="true">
              /
            </span>
          )}
          {isLast || !item.href ? (
            <span
              class="font-medium text-zinc-900 dark:text-zinc-100"
              aria-current={isLast ? "page" : undefined}
            >
              {item.label}
            </span>
          ) : (
            <a
              href={item.href}
              class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

