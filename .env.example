# Web3Forms API Key for Contact Form
# Obtain an access key at https://web3forms.com
PUBLIC_WEB3FORMS_ACCESS_KEY=your_access_key_here

# PostHog Web Analytics & Session Replay
# Obtain API key from PostHog Project Settings -> Project API Key
PUBLIC_POSTHOG_API_KEY=phc_your_posthog_project_api_key_here
# Optional: Set to https://eu.i.posthog.com if your project is hosted in the EU cloud (default: https://us.i.posthog.com)
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

